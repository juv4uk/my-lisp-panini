;; Panini Machine Model v0.1 — Rule Engine
;; First concrete rules, derived from the traced derivation of Bavati.
;; All identifiers strictly use SLP1 encoding.
;;
;; Architecture (based on research/computational-hypotheses.md):
;;   - Each RULE is a declarative data object (not a raw function)
;;   - The DERIVATION STATE is an immutable list of TERMs
;;   - Each step produces a NEW state (functional, not mutable)
;;   - TAGs carry information between rules (confirmed from Vidyut audit)

;; ==========================================
;; Term — Basic Unit of Derivation
;; ==========================================
;; A term has:
;;   upadesha — canonical form (immutable, contains it-markers)
;;   text     — current phonetic form (changes each step)
;;   tags     — metadata set (S-it, p-it, sArvaDAtukaM, dhAtu, ...)
;;   type     — dhAtu | pratyaya | vikarana | tiN
;;
;; We represent a term as an a-list:
(defun make-term (upadesha type)
  (list (cons 'upadesha upadesha)
        (cons 'text     upadesha)  ;; text starts as upadesha
        (cons 'type     type)
        (cons 'tags     '())))

(defun term-upadesha (term) (cdr (assoc 'upadesha term)))
(defun term-text     (term) (cdr (assoc 'text     term)))
(defun term-type     (term) (cdr (assoc 'type     term)))
(defun term-tags     (term) (cdr (assoc 'tags     term)))

(defun term-has-tag (term tag)
  (member tag (term-tags term)))

;; Returns a new term with a tag added (immutable update)
(defun term-add-tag (term tag)
  (list (cons 'upadesha (term-upadesha term))
        (cons 'text     (term-text     term))
        (cons 'type     (term-type     term))
        (cons 'tags     (cons tag (term-tags term)))))

;; Returns a new term with text updated (immutable update)
(defun term-set-text (term new-text)
  (list (cons 'upadesha (term-upadesha term))
        (cons 'text     new-text)
        (cons 'type     (term-type     term))
        (cons 'tags     (term-tags     term))))

;; ==========================================
;; Prakriya — Derivation State
;; ==========================================
;; A prakriya is a list: (terms . history)
;;   terms   — current list of Term objects
;;   history — list of (step sutra old-state new-state) for tracing
;;
(defun make-prakriya (terms)
  (cons terms '()))

(defun prakriya-terms   (p) (car p))
(defun prakriya-history (p) (cdr p))

;; Record a step and return a new prakriya (immutable)
(defun prakriya-record (p sutra new-terms)
  (cons new-terms
        (cons (list 'step sutra (prakriya-terms p) new-terms)
              (prakriya-history p))))

;; ==========================================
;; Pratyāhāra Sets (from sounds.rs audit)
;; SLP1 characters only.
;; ==========================================
(setq AC  '(a A i I u U f F x X e E o O))  ;; all vowels
(setq HAL '(k K g G N c C j J Y w W q Q R t T d D n p P b B m y r l v S z s h)) ;; all consonants
(setq IK  '(i I u U f F x X))              ;; close vowels

(defun is-vowel (sound) (member sound AC))
(defun is-consonant (sound) (member sound HAL))

;; ==========================================
;; Guṇa Table (1.1.2 adeng guṇaḥ)
;; ==========================================
(setq guRa-table
  '((a . a) (A . a)
    (i . e) (I . e)
    (u . o) (U . o)
    (f . ar) (F . ar)
    (x . al)))

(defun apply-guRa (vowel)
  (let ((result (assoc vowel guRa-table)))
    (if result (cdr result) vowel)))

;; ==========================================
;; It-Samjña Rules (1.3.2 – 1.3.9)
;; ==========================================

;; SLP1 sounds that are it when at the end of a pratyaya (halantyam 1.3.3)
(setq HAL-it-sounds '(p k t c))

;; SLP1 sounds that are it when at start of a suffix (cu~tu~ rule 1.3.7)
(setq S-it-sounds '(S))  ;; Ś is the key one for Śap

;; Rule 1.3.9 — tasya lopaH
;; Marks and removes it from a term's text, leaving tags.
;; Returns a new term.
(defun apply-it-samjna (term)
  (let* ((text (term-text term))
         (last-char (last text))   ;; halantyam — last consonant
         (first-char (car text)))  ;; check for S-it etc.
    (let* ((with-tags
            ;; 1.3.3: halantyam — mark final consonant as it
            (if (member last-char HAL-it-sounds)
                (term-add-tag term 'p-it)
                term))
           (with-more-tags
            ;; 1.3.7: S at start of suffix → sArvaDAtukaM tag
            (if (member first-char S-it-sounds)
                (term-add-tag with-tags 'sArvaDAtukaM)
                with-tags)))
      ;; tasya lopaH — remove it letters from text
      ;; (simplified: remove known it chars)
      (term-set-text with-more-tags
                     (remove-its text HAL-it-sounds S-it-sounds)))))

(defun remove-its (text hal-its s-its)
  ;; Remove leading S-it and trailing HAL-it from text
  (let* ((trimmed-end
          (if (member (last text) hal-its)
              (butlast text)
              text))
         (trimmed-start
          (if (member (car trimmed-end) s-its)
              (cdr trimmed-end)
              trimmed-end)))
    trimmed-start))

;; ==========================================
;; Rule 7.3.84 — sArvaDAtukarDADAtukayoH (Guṇa)
;; If the next suffix has tag sArvaDAtukaM,
;; apply guṇa to the final vowel of the dhātu.
;; ==========================================
(defun rule-7-3-84 (dhatu-term next-suffix-term)
  (if (term-has-tag next-suffix-term 'sArvaDAtukaM)
      ;; Apply guṇa to last vowel of dhātu text
      (let* ((dtext (term-text dhatu-term))
             (last-v (last dtext))
             (guna-v (apply-guRa last-v))
             (new-text (append (butlast dtext) (list guna-v))))
        (term-set-text dhatu-term new-text))
      dhatu-term))  ;; no change if not sArvaDAtukaM

;; ==========================================
;; Rule 6.1.78 — eco 'yavāyāvaḥ (Sandhi)
;; o before vowel → av
;; ==========================================
(setq eco-map '((e . ay) (o . av) (E . Ay) (O . Av)))

(defun apply-eco-sandhi (sound next-sound)
  (if (is-vowel next-sound)
      (let ((mapped (assoc sound eco-map)))
        (if mapped (cdr mapped) sound))
      sound))

;; ==========================================
;; Full Bavati Derivation (Step-by-Step)
;; Follows Bavati.md exactly.
;; ==========================================
(defun derive-Bavati ()
  ;; Step 1-2: BU + laT → BU + tip
  (let* ((dhatu  (make-term '(B U) 'dhAtu))
         (tin    (make-term '(t i p) 'tiN))
         (p1 (make-prakriya (list dhatu tin))))

    ;; Step 3: it-removal from tip (p → tag, text → ti)
    (let* ((tin-after-it (apply-it-samjna tin))
           (p3 (prakriya-record p1 "1.3.3+1.3.9" (list dhatu tin-after-it))))

      ;; Step 4: add vikarana Sap between dhatu and tiN
      ;; Here we use with-adhikara to simulate being inside the adhikara of:
      ;; 3.1.1 pratyayaH and 3.1.91 DAtoH
      (with-adhikara '((:scope . "pratyaya") (:base . "dhatu"))
        (let* ((vikarana (make-term '(S a p) 'vikarana))
               ;; We can theoretically read (get-context :scope) inside the rule engine here
               (p4 (prakriya-record p3 "3.1.68"
                     (list dhatu vikarana tin-after-it))))

          ;; Step 5: it-removal from Sap (S,p → tags, text → a, adds sArvaDAtukaM)
          (let* ((vk-after-it (apply-it-samjna vikarana))
                 (p5 (prakriya-record p4 "1.3.7+1.3.9"
                       (list dhatu vk-after-it tin-after-it))))

            ;; Step 6: Guṇa on dhātu (U → o) because vikarana has sArvaDAtukaM
            (let* ((dhatu-guna (rule-7-3-84 dhatu vk-after-it))
                   (p6 (prakriya-record p5 "7.3.84"
                         (list dhatu-guna vk-after-it tin-after-it))))

              ;; Step 7: Sandhi o+a → av+a
              ;; (dhatu ends in 'o', vikarana starts with 'a')
              ;; Result: (B av a t i) = Bavati
              (prakriya-record p6 "6.1.78"
                (list (term-set-text dhatu-guna '(B a v))
                      vk-after-it
                      tin-after-it)))))))))
