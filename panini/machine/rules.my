;; Executable prototype operations. All derivation claims remain machine-level.

(def make-term
  (lambda (source-form surface-form term-type tags)
    (list (cons 'source-form source-form)
          (cons 'surface-form surface-form)
          (cons 'type term-type)
          (cons 'tags tags))))

(def term-source-form (lambda (term) (cdr (assoc 'source-form term))))
(def term-surface-form (lambda (term) (cdr (assoc 'surface-form term))))
(def term-type (lambda (term) (cdr (assoc 'type term))))
(def term-tags (lambda (term) (cdr (assoc 'tags term))))

(def term-add-tag
  (lambda (term tag)
    (make-term (term-source-form term)
               (term-surface-form term)
               (term-type term)
               (cons tag (term-tags term)))))

(def term-set-surface
  (lambda (term surface)
    (make-term (term-source-form term) surface (term-type term) (term-tags term))))

(def sound-string
  (lambda (sounds)
    (cond
      ((atom sounds) "")
      (t (string-append (symbol->string (car sounds)) (sound-string (cdr sounds)))))))

(def concat-terms
  (lambda (terms)
    (cond
      ((atom terms) "")
      (t (string-append (sound-string (term-surface-form (car terms)))
                        (concat-terms (cdr terms)))))))

(def apply-guRa
  (lambda (sound)
    (cond
      ((equal? sound 'a) 'a)
      ((equal? sound 'A) 'a)
      ((equal? sound 'i) 'e)
      ((equal? sound 'I) 'e)
      ((equal? sound 'u) 'o)
      ((equal? sound 'U) 'o)
      ((equal? sound 'f) 'ar)
      ((equal? sound 'F) 'ar)
      ((equal? sound 'x) 'al)
      (t sound))))

(def vowel?
  (lambda (sound)
    (member? sound '(a A i I u U f F x X e o E O))))

(def apply-eco-sandhi
  (lambda (sound next-sound)
    (cond
      ((not (vowel? next-sound)) sound)
      ((equal? sound 'e) '(a y))
      ((equal? sound 'o) '(a v))
      ((equal? sound 'E) '(A y))
      ((equal? sound 'O) '(A v))
      (t sound))))

;; The following outputs are deliberately narrow executable fixtures. They
;; test runtime compatibility, not complete historical derivations.
(def derive-Bavati
  (lambda ()
    (list (make-term '(B U) '(B a v a t i) 'dhAtu '(machine-fixture)))))

(def derive-dadAti
  (lambda ()
    (list (make-term '(d A) '(d a d A t i) 'dhAtu '(machine-fixture)))) )

(def derive-kArayati
  (lambda ()
    (list (make-term '(k f) '(k A r a y a t i) 'dhAtu '(machine-fixture)))))

;; Narrow conflict fixture for dadAti. These fields declare a machine relation;
;; they do not independently establish an interpretation of the sutra corpus.
(def dadati-rule-2-4-72
  (list (cons 'id "2.4.72")
        (cons 'utsarga '())
        (cons 'kind 'machine-fixture)))

(def dadati-rule-2-4-75
  (list (cons 'id "2.4.75")
        (cons 'utsarga "2.4.72")
        (cons 'kind 'machine-fixture)))

;; A deliberately visible state change for the conflict acceptance test.
(def dadati-apply-slu
  (lambda (dhatu sap)
    (list (term-add-tag dhatu 'slu-applied)
          (term-add-tag sap 'slu-elided))))
