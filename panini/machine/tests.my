;; Panini machine compatibility tests; dependencies are loaded by the entrypoint.

(def assert-equal
  (lambda (expected actual label)
    (cond
      ((equal? expected actual) (print (string-append "[PASS] " label)))
      (t (print (string-append "[FAIL] " label))))) )

(def test-pratyahara
  (lambda ()
    (assert-equal '(a i u f x e o E O) AC "AC fixture")
    (assert-equal '(i u f x) IK "IK fixture")
    (assert-equal '(e o E O) EC "EC fixture")))

(def test-eco-sandhi
  (lambda ()
    (assert-equal '(a y) (apply-eco-sandhi 'e 'a) "eco e+a")
    (assert-equal '(a v) (apply-eco-sandhi 'o 'a) "eco o+a")
    (assert-equal '(A y) (apply-eco-sandhi 'E 'a) "eco E+a")
    (assert-equal '(A v) (apply-eco-sandhi 'O 'a) "eco O+a")))

(def test-guna
  (lambda ()
    (assert-equal 'o (apply-guRa 'u) "guna u")
    (assert-equal 'o (apply-guRa 'U) "guna U")
    (assert-equal 'e (apply-guRa 'i) "guna i")
    (assert-equal 'ar (apply-guRa 'f) "guna f")))

(def test-prototype-derivations
  (lambda ()
    (assert-equal "Bavati" (concat-terms (derive-Bavati)) "Bavati prototype")
    (assert-equal "dadAti" (concat-terms (derive-dadAti)) "dadAti prototype")
    (assert-equal "kArayati" (concat-terms (derive-kArayati)) "kArayati prototype")))

(def test-dadati-declared-conflict
  (lambda ()
    (assert-equal "2.4.72" (rule-id dadati-rule-2-4-72)
                  "dadAti general rule id")
    (assert-equal "2.4.75" (rule-id dadati-rule-2-4-75)
                  "dadAti exception rule id")
    (assert-equal "2.4.72" (rule-utsarga dadati-rule-2-4-75)
                  "dadAti declared utsarga")
    (assert-equal 'resolved-by
                  (car (resolve-declared-apavada-traced
                        dadati-rule-2-4-72 dadati-rule-2-4-75))
                  "dadAti conflict trace status")
    (assert-equal 'apavAda
                  (second (resolve-declared-apavada-traced
                           dadati-rule-2-4-72 dadati-rule-2-4-75))
                  "dadAti conflict trace reason")
    (assert-equal "2.4.75"
                  (rule-id (third (resolve-declared-apavada-traced
                                   dadati-rule-2-4-72 dadati-rule-2-4-75)))
                  "dadAti conflict winner")
    (assert-equal t
                  (member? 'slu-applied
                           (term-tags (car (dadati-apply-slu
                                             (make-term '(d A) '(d A) 'dhAtu '())
                                             (make-term '(S a p) '(S a p) 'pratyaya '())))))
                  "dadAti Slu dhatu transition")
    (assert-equal t
                  (member? 'slu-elided
                           (term-tags (second (dadati-apply-slu
                                               (make-term '(d A) '(d A) 'dhAtu '())
                                               (make-term '(S a p) '(S a p) 'pratyaya '())))))
                  "dadAti Slu pratyaya transition")))

(def canonical-empty-state
  "{\"relations\":[],\"schema\":\"panini-state/0.1\",\"serialization\":\"canonical-json-sha256-v0.1\",\"terms\":[]}\n")

(def canonical-sap-state
  "{\"relations\":[],\"schema\":\"panini-state/0.1\",\"serialization\":\"canonical-json-sha256-v0.1\",\"terms\":[{\"id\":\"term:vikarana-Sap-raw\",\"kind\":\"pratyaya\",\"source_form\":\"Sap\",\"surface_form\":\"Sap\"}]}\n")

(def test-trace-canonical-serialization
  (lambda ()
    (assert-equal "23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854"
                  (sha256-hex canonical-empty-state)
                  "canonical state vector A digest")
    (assert-equal "7b19d66e1d5e24edf54f455a34bfb8fbeee28c3058b78801c1412ea1f431a09b"
                  (sha256-hex canonical-sap-state)
                  "canonical state vector B digest")
    (assert-equal "state:sha256:23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854"
                  (string-append "state:sha256:" (sha256-hex canonical-empty-state))
                  "content-addressed state prefix")
    (assert-equal t
                  (not (equal? (sha256-hex canonical-empty-state)
                               (sha256-hex canonical-sap-state)))
                  "distinct states give distinct digests")))

(def run-tests
  (lambda ()
    (print "Running Panini Machine Tests...")
    (test-pratyahara)
    (test-eco-sandhi)
    (test-guna)
    (test-prototype-derivations)
    (test-dadati-declared-conflict)
    (test-trace-canonical-serialization)
    (print "Tests complete.")))
