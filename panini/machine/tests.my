;; Panini machine compatibility tests; dependencies are loaded by the entrypoint.

(def assert-equal
  (lambda (expected actual label)
    (cond
      ((equal? expected actual) (print (string-append "[PASS] " label)))
      (t (print (string-append "[FAIL] " label))))) )

(def test-pratyahara
  (lambda ()
    (assert-equal '(a i u f x e o E O) AC "AC fixture")
    (assert-equal '(i u f x) IK "IK fixture")
    (assert-equal '(e o E O) EC "EC fixture")))

(def test-eco-sandhi
  (lambda ()
    (assert-equal '(a y) (apply-eco-sandhi 'e 'a) "eco e+a")
    (assert-equal '(a v) (apply-eco-sandhi 'o 'a) "eco o+a")
    (assert-equal '(A y) (apply-eco-sandhi 'E 'a) "eco E+a")
    (assert-equal '(A v) (apply-eco-sandhi 'O 'a) "eco O+a")))

(def test-guna
  (lambda ()
    (assert-equal 'o (apply-guRa 'u) "guna u")
    (assert-equal 'o (apply-guRa 'U) "guna U")
    (assert-equal 'e (apply-guRa 'i) "guna i")
    (assert-equal 'ar (apply-guRa 'f) "guna f")))

(def test-prototype-derivations
  (lambda ()
    (assert-equal "Bavati" (concat-terms (derive-Bavati)) "Bavati prototype")
    (assert-equal "dadAti" (concat-terms (derive-dadAti)) "dadAti prototype")
    (assert-equal "kArayati" (concat-terms (derive-kArayati)) "kArayati prototype")))

(def run-tests
  (lambda ()
    (print "Running Panini Machine Tests...")
    (test-pratyahara)
    (test-eco-sandhi)
    (test-guna)
    (test-prototype-derivations)
    (print "Tests complete.")))
