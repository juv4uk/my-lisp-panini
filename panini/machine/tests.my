;; Panini machine compatibility tests; dependencies are loaded by the entrypoint.

(def assert-equal
  (lambda (expected actual label)
    (cond
      ((equal? expected actual) (print (string-append "[PASS] " label)))
      (t (print (string-append "[FAIL] " label))))) )

(def test-pratyahara
  (lambda ()
    (assert-equal '(a i u f x e o E O) AC "AC fixture")
    (assert-equal '(i u f x) IK "IK fixture")
    (assert-equal '(e o E O) EC "EC fixture")))

(def test-eco-sandhi
  (lambda ()
    (assert-equal '(a y) (apply-eco-sandhi 'e 'a) "eco e+a")
    (assert-equal '(a v) (apply-eco-sandhi 'o 'a) "eco o+a")
    (assert-equal '(A y) (apply-eco-sandhi 'E 'a) "eco E+a")
    (assert-equal '(A v) (apply-eco-sandhi 'O 'a) "eco O+a")))

(def test-guna
  (lambda ()
    (assert-equal 'o (apply-guRa 'u) "guna u")
    (assert-equal 'o (apply-guRa 'U) "guna U")
    (assert-equal 'e (apply-guRa 'i) "guna i")
    (assert-equal 'ar (apply-guRa 'f) "guna f")))

(def test-prototype-derivations
  (lambda ()
    (assert-equal "Bavati" (concat-terms (derive-Bavati)) "Bavati prototype")
    (assert-equal "dadAti" (concat-terms (derive-dadAti)) "dadAti prototype")
    (assert-equal "kArayati" (concat-terms (derive-kArayati)) "kArayati prototype")))

(def test-dadati-declared-conflict
  (lambda ()
    (assert-equal "2.4.72" (rule-id dadati-rule-2-4-72)
                  "dadAti general rule id")
    (assert-equal "2.4.75" (rule-id dadati-rule-2-4-75)
                  "dadAti exception rule id")
    (assert-equal "2.4.72" (rule-utsarga dadati-rule-2-4-75)
                  "dadAti declared utsarga")
    (assert-equal 'resolved-by
                  (car (resolve-declared-apavada-traced
                        dadati-rule-2-4-72 dadati-rule-2-4-75))
                  "dadAti conflict trace status")
    (assert-equal 'apavAda
                  (second (resolve-declared-apavada-traced
                           dadati-rule-2-4-72 dadati-rule-2-4-75))
                  "dadAti conflict trace reason")
    (assert-equal "2.4.75"
                  (rule-id (third (resolve-declared-apavada-traced
                                   dadati-rule-2-4-72 dadati-rule-2-4-75)))
                  "dadAti conflict winner")
    (assert-equal t
                  (member? 'slu-applied
                           (term-tags (car (dadati-apply-slu
                                             (make-term '(d A) '(d A) 'dhAtu '())
                                             (make-term '(S a p) '(S a p) 'pratyaya '())))))
                  "dadAti Slu dhatu transition")
    (assert-equal t
                  (member? 'slu-elided
                           (term-tags (second (dadati-apply-slu
                                               (make-term '(d A) '(d A) 'dhAtu '())
                                               (make-term '(S a p) '(S a p) 'pratyaya '())))))
                  "dadAti Slu pratyaya transition")))

(def canonical-empty-state
  "{\"relations\":[],\"schema\":\"panini-state/0.1\",\"serialization\":\"canonical-json-sha256-v0.1\",\"terms\":[]}\n")

(def canonical-sap-state
  "{\"relations\":[],\"schema\":\"panini-state/0.1\",\"serialization\":\"canonical-json-sha256-v0.1\",\"terms\":[{\"id\":\"term:vikarana-Sap-raw\",\"kind\":\"pratyaya\",\"source_form\":\"Sap\",\"surface_form\":\"Sap\"}]}\n")

(def test-trace-canonical-serialization
  (lambda ()
    (assert-equal "23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854"
                  (sha256-hex canonical-empty-state)
                  "canonical state vector A digest")
    (assert-equal "7b19d66e1d5e24edf54f455a34bfb8fbeee28c3058b78801c1412ea1f431a09b"
                  (sha256-hex canonical-sap-state)
                  "canonical state vector B digest")
    (assert-equal "state:sha256:23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854"
                  (string-append "state:sha256:" (sha256-hex canonical-empty-state))
                  "content-addressed state prefix")
    (assert-equal t
                  (not (equal? (sha256-hex canonical-empty-state)
                               (sha256-hex canonical-sap-state)))
                  "distinct states give distinct digests")))

;; Explanation-boundary contract (specs/derivation-machine-explanation-boundary-v0.1.md):
;; a machine explanation is a falsifiable, exhibit-able claim. A transition is
;; explainable when it carries rule + provenance; a conflict choice without
;; source support is an honest needs-check label, never derived.
(def explanation-state-fact
  (list 'state 'sha256-hex (sha256-hex canonical-empty-state)))

(def explanation-transition
  (list (cons 'kind 'transition)
        (cons 'before "state:sha256:23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854")
        (cons 'after "state:sha256:7b19d66e1d5e24edf54f455a34bfb8fbeee28c3058b78801c1412ea1f431a09b")
        (cons 'rule "1.1.2")
        (cons 'provenance 'prov:machine:guna-fixture)))

(def outside-boundary-claim
  (list (cons 'kind 'claim)
        (cons 'claim 'historical-intent)
        (cons 'label 'needs-check)
        (cons 'support '())))

(def test-explanation-boundary
  (lambda ()
    (assert-equal 'state (car explanation-state-fact)
                  "explanation level: state fact")
    (assert-equal 'needs-check
                  (cdr (assoc 'label outside-boundary-claim))
                  "outside-boundary claim is honestly labelled needs-check")
    (assert-equal '()
                  (cdr (assoc 'support outside-boundary-claim))
                  "outside-boundary claim exhibits no machine support")
    (assert-equal "1.1.2"
                  (cdr (assoc 'rule explanation-transition))
                  "transition explanation carries rule")
    (assert-equal 'prov:machine:guna-fixture
                  (cdr (assoc 'provenance explanation-transition))
                  "transition explanation carries provenance")))

(def test-karoti-derivation
  (lambda ()
    (assert-equal "3.1.79" (rule-id karoti-vikarana-snu)
                  "karoti vikaraNa rule id")
    (assert-equal 'SNu (rule-field 'vikarana karoti-vikarana-snu)
                  "karoti vikaraNa is SNu")
    (assert-equal '(k ar) (apply-guRa-sounds '(k f))
                  "karoti root guNa f -> ar")
    (assert-equal '(o) (apply-guRa-sounds '(u))
                  "karoti vikaraNa guNa u -> o")
    (assert-equal "karoti" (concat-terms (derive-karoti))
                  "karoti surface form")))

(def test-pacati-derivation
  (lambda ()
    (assert-equal "3.1.68" (rule-id pacati-sap-vikarana)
                  "pacati vikaraNa rule id")
    (assert-equal 'Sap (rule-field 'vikarana pacati-sap-vikarana)
                  "pacati vikaraNa is Sap")
    (assert-equal 1 (rule-field 'gana pac-gana)
                  "pac is class 1 (bhvAdi)")
    (assert-equal "pacati" (concat-terms (derive-pacati))
                  "pacati surface form")
    (assert-equal 'odana
                  (cdr (assoc 'karman (cdr (assoc 'kAraka-args (pacati-3karaka)))))
                  "pacati 3-kAraka karman")
    (assert-equal 'sTAlI
                  (cdr (assoc 'aDikaraRa (cdr (assoc 'kAraka-args (pacati-3karaka)))))
                  "pacati 3-kAraka aDikaraRa")))

(def test-anuvrtti-dag-edges
  (lambda ()
    (assert-equal '() (rule-inherits-from panini-rule-3-1-1)
                  "3.1.1 aDikAra root has no inherited words")
    (assert-equal '("3.1.1") (rule-inherits-from panini-rule-3-1-68)
                  "3.1.68 inherits from 3.1.1")
    (assert-equal '("3.1.1") (rule-inherits-from panini-rule-3-1-79)
                  "3.1.79 inherits from 3.1.1")
    (assert-equal 'pratyayaH (car (rule-inherits-words panini-rule-3-1-68))
                  "3.1.68 inherits word pratyayaH")
    (assert-equal t (dag-edges-resolve? anuvrtti-graph-rules)
                  "all anuvRtti edges resolve to existing rules")))

(def test-negative-derivation-fixtures
  (lambda ()
    (assert-equal t
                  (it-deletable? (term-add-tag (make-term '(s) '(s) 'it '()) 'it-marker))
                  "it deletion allowed only on marked it")
    (assert-equal '()
                  (it-deletable? (make-term '(s) '(s) 'it '()))
                  "unmarked it is rejected")
    (assert-equal t (guNa-eligible? 'i) "guNa eligible on short i")
    (assert-equal '() (guNa-eligible? 'a) "guNa rejected on a (no eligible condition)")
    (assert-equal t (slp1-r-vowel? 'f) "SLP1 f recognized as R vowel")
    (assert-equal '() (slp1-r-vowel? 'r) "bare r spelling rejected")
    (assert-equal t
                  (sap-eligible? (make-term '(d A) '(d A) 'dhAtu '(class-1)))
                  "Sap eligible on non-juhotyAdi")
    (assert-equal '()
                  (sap-eligible? (make-term '(d A) '(d A) 'dhAtu '(juhotyAdi)))
                  "Sap rejected on juhotyAdi without Slu")
    (assert-equal '()
                  (ambiguous-apavada? dadati-rule-2-4-72 dadati-rule-2-4-75)
                  "declared dadAti priority is unambiguous")
    (assert-equal t
                  (ambiguous-apavada? incorrect-priority-pair-a incorrect-priority-pair-b)
                  "mutual apavAda declarations rejected as ambiguous")))

(def test-panini-core-syntax
  (lambda ()
    (assert-equal "1.4.54" (get-karaka 'kartf 'sutra) "core get-karaka sutra")
    (assert-equal 'agent (get-karaka 'kartf 'semantic-role) "core get-karaka role")
    (assert-equal 'gam (cdr (assoc 'dhAtu example-gam)) "core example-gam dhatu")
    (assert-equal 'sTAlI
                  (cdr (assoc 'aDikaraRa (cdr (assoc 'kAraka-args example-pac-full))))
                  "core example-pac-full aDikaraRa")
    (assert-equal 8 (cdr (assoc 'class (cdr (assoc 'kf dhatu-registry))))
                  "core dhatu-registry kf class")))

(def run-tests
  (lambda ()
    (print "Running Panini Machine Tests...")
    (test-pratyahara)
    (test-eco-sandhi)
    (test-guna)
    (test-prototype-derivations)
    (test-dadati-declared-conflict)
    (test-karoti-derivation)
    (test-pacati-derivation)
    (test-anuvrtti-dag-edges)
    (test-negative-derivation-fixtures)
    (test-trace-canonical-serialization)
    (test-explanation-boundary)
    (test-panini-core-syntax)
    (print "Tests complete.")))
