;; Panini machine compatibility tests; dependencies are loaded by the entrypoint.

(def assert-equal
  (lambda (expected actual label)
    (cond
      ((equal? expected actual) (print (string-append "[PASS] " label)))
      (t (print (string-append "[FAIL] " label))))) )

(def test-pratyahara
  (lambda ()
    (assert-equal (quote (a i u f x e o E O)) AC "AC fixture")
    (assert-equal (quote (i u f x)) IK "IK fixture")
    (assert-equal (quote (e o E O)) EC "EC fixture")))

(def test-eco-sandhi
  (lambda ()
    (assert-equal (quote (a y)) (apply-eco-sandhi (quote e) (quote a)) "eco e+a")
    (assert-equal (quote (a v)) (apply-eco-sandhi (quote o) (quote a)) "eco o+a")
    (assert-equal (quote (A y)) (apply-eco-sandhi (quote E) (quote a)) "eco E+a")
    (assert-equal (quote (A v)) (apply-eco-sandhi (quote O) (quote a)) "eco O+a")))

(def test-guna
  (lambda ()
    (assert-equal (quote o) (apply-guRa (quote u)) "guna u")
    (assert-equal (quote o) (apply-guRa (quote U)) "guna U")
    (assert-equal (quote e) (apply-guRa (quote i)) "guna i")
    (assert-equal (quote ar) (apply-guRa (quote f)) "guna f")))

(def test-prototype-derivations
  (lambda ()
    (assert-equal "Bavati" (concat-terms bavati-surface-terms) "Bavati prototype")
    (assert-equal "dadAti" (concat-terms (derive-dadAti)) "dadAti prototype")
    (assert-equal "kArayati" (concat-terms (derive-kArayati)) "kArayati prototype")))

(def test-dadati-declared-conflict
  (lambda ()
    (assert-equal "2.4.72" (rule-id dadati-rule-2-4-72)
                  "dadAti general rule id")
    (assert-equal "2.4.75" (rule-id dadati-rule-2-4-75)
                  "dadAti exception rule id")
    (assert-equal "2.4.72" (rule-utsarga dadati-rule-2-4-75)
                  "dadAti declared utsarga")
    (assert-equal (quote resolved-by)
                  (car (resolve-declared-apavada-traced
                        dadati-rule-2-4-72 dadati-rule-2-4-75))
                  "dadAti conflict trace status")
    (assert-equal (quote apavAda)
                  (second (resolve-declared-apavada-traced
                           dadati-rule-2-4-72 dadati-rule-2-4-75))
                  "dadAti conflict trace reason")
    (assert-equal "2.4.75"
                  (rule-id (third (resolve-declared-apavada-traced
                                   dadati-rule-2-4-72 dadati-rule-2-4-75)))
                  "dadAti conflict winner")
    (assert-equal t
                  (member? (quote slu-applied)
                           (term-tags (car (dadati-apply-slu
                                             (make-term (quote (d A)) (quote (d A)) (quote dhAtu) (quote ()))
                                             (make-term (quote (S a p)) (quote (S a p)) (quote pratyaya) (quote ()))))))
                  "dadAti Slu dhatu transition")
    (assert-equal t
                  (member? (quote slu-elided)
                           (term-tags (second (dadati-apply-slu
                                               (make-term (quote (d A)) (quote (d A)) (quote dhAtu) (quote ()))
                                               (make-term (quote (S a p)) (quote (S a p)) (quote pratyaya) (quote ()))))))
                  "dadAti Slu pratyaya transition")))

(def canonical-empty-state
  "{\"relations\":[],\"schema\":\"panini-state/0.1\",\"serialization\":\"canonical-json-sha256-v0.1\",\"terms\":[]}\n")

(def canonical-sap-state
  "{\"relations\":[],\"schema\":\"panini-state/0.1\",\"serialization\":\"canonical-json-sha256-v0.1\",\"terms\":[{\"id\":\"term:vikarana-Sap-raw\",\"kind\":\"pratyaya\",\"source_form\":\"Sap\",\"surface_form\":\"Sap\"}]}\n")

(def test-trace-canonical-serialization
  (lambda ()
    (assert-equal "23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854"
                  (sha256-hex canonical-empty-state)
                  "canonical state vector A digest")
    (assert-equal "7b19d66e1d5e24edf54f455a34bfb8fbeee28c3058b78801c1412ea1f431a09b"
                  (sha256-hex canonical-sap-state)
                  "canonical state vector B digest")
    (assert-equal "state:sha256:23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854"
                  (string-append "state:sha256:" (sha256-hex canonical-empty-state))
                  "content-addressed state prefix")
    (assert-equal t
                  (not (equal? (sha256-hex canonical-empty-state)
                               (sha256-hex canonical-sap-state)))
                  "distinct states give distinct digests")))

;; Explanation-boundary contract (specs/derivation-machine-explanation-boundary-v0.1.md):
;; a machine explanation is a falsifiable, exhibit-able claim. A transition is
;; explainable when it carries rule + provenance; a conflict choice without
;; source support is an honest needs-check label, never derived.
(def explanation-state-fact
  (list (quote state) (quote sha256-hex) (sha256-hex canonical-empty-state)))

(def explanation-transition
  (list (cons (quote kind) (quote transition))
        (cons (quote before) "state:sha256:23aa0265da93189f9a093c2b6698ae91baa345c58a30754ee5cc6ffb7698e854")
        (cons (quote after) "state:sha256:7b19d66e1d5e24edf54f455a34bfb8fbeee28c3058b78801c1412ea1f431a09b")
        (cons (quote rule) "1.1.2")
        (cons (quote provenance) (quote prov:machine:guna-fixture))))

(def outside-boundary-claim
  (list (cons (quote kind) (quote claim))
        (cons (quote claim) (quote historical-intent))
        (cons (quote label) (quote needs-check))
        (cons (quote support) (quote ()))))

(def test-explanation-boundary
  (lambda ()
    (assert-equal (quote state) (car explanation-state-fact)
                  "explanation level: state fact")
    (assert-equal (quote needs-check)
                  (cdr (assoc (quote label) outside-boundary-claim))
                  "outside-boundary claim is honestly labelled needs-check")
    (assert-equal (quote ())
                  (cdr (assoc (quote support) outside-boundary-claim))
                  "outside-boundary claim exhibits no machine support")
    (assert-equal "1.1.2"
                  (cdr (assoc (quote rule) explanation-transition))
                  "transition explanation carries rule")
    (assert-equal (quote prov:machine:guna-fixture)
                  (cdr (assoc (quote provenance) explanation-transition))
                  "transition explanation carries provenance")))

(def test-karoti-derivation
  (lambda ()
    (assert-equal "3.1.79" (rule-id karoti-vikarana-snu)
                  "karoti vikaraNa rule id")
    (assert-equal (quote SNu) (rule-field (quote vikarana) karoti-vikarana-snu)
                  "karoti vikaraNa is SNu")
    (assert-equal (quote (k ar)) (apply-guRa-sounds (quote (k f)))
                  "karoti root guNa f -> ar")
    (assert-equal (quote (o)) (apply-guRa-sounds (quote (u)))
                  "karoti vikaraNa guNa u -> o")
    (assert-equal "karoti" (concat-terms (derive-karoti))
                  "karoti surface form")))

(def test-pacati-derivation
  (lambda ()
    (assert-equal "3.1.68" (rule-id pacati-sap-vikarana)
                  "pacati vikaraNa rule id")
    (assert-equal (quote Sap) (rule-field (quote vikarana) pacati-sap-vikarana)
                  "pacati vikaraNa is Sap")
    (assert-equal 1 (rule-field (quote gana) pac-gana)
                  "pac is class 1 (bhvAdi)")
    (assert-equal "pacati" (concat-terms (derive-pacati))
                  "pacati surface form")
    (assert-equal (quote odana)
                  (cdr (assoc (quote karman) (cdr (assoc (quote kAraka-args) (pacati-3karaka)))))
                  "pacati 3-kAraka karman")
    (assert-equal (quote sTAlI)
                  (cdr (assoc (quote aDikaraRa) (cdr (assoc (quote kAraka-args) (pacati-3karaka)))))
                  "pacati 3-kAraka aDikaraRa")))

(def test-anuvrtti-dag-edges
  (lambda ()
    (assert-equal (quote ()) (rule-inherits-from panini-rule-3-1-1)
                  "3.1.1 aDikAra root has no inherited words")
    (assert-equal (quote ("3.1.1")) (rule-inherits-from panini-rule-3-1-68)
                  "3.1.68 inherits from 3.1.1")
    (assert-equal (quote ("3.1.1")) (rule-inherits-from panini-rule-3-1-79)
                  "3.1.79 inherits from 3.1.1")
    (assert-equal (quote pratyayaH) (car (rule-inherits-words panini-rule-3-1-68))
                  "3.1.68 inherits word pratyayaH")
    (assert-equal t (dag-edges-resolve? anuvrtti-graph-rules)
                  "all anuvRtti edges resolve to existing rules")))

(def test-negative-derivation-fixtures
  (lambda ()
    (assert-equal t
                  (it-deletable? (term-add-tag (make-term (quote (s)) (quote (s)) (quote it) (quote ())) (quote it-marker)))
                  "it deletion allowed only on marked it")
    (assert-equal (quote ())
                  (it-deletable? (make-term (quote (s)) (quote (s)) (quote it) (quote ())))
                  "unmarked it is rejected")
    (assert-equal t (guNa-eligible? (quote i)) "guNa eligible on short i")
    (assert-equal (quote ()) (guNa-eligible? (quote a)) "guNa rejected on a (no eligible condition)")
    (assert-equal t (slp1-r-vowel? (quote f)) "SLP1 f recognized as R vowel")
    (assert-equal (quote ()) (slp1-r-vowel? (quote r)) "bare r spelling rejected")
    (assert-equal t
                  (sap-eligible? (make-term (quote (d A)) (quote (d A)) (quote dhAtu) (quote (class-1))))
                  "Sap eligible on non-juhotyAdi")
    (assert-equal (quote ())
                  (sap-eligible? (make-term (quote (d A)) (quote (d A)) (quote dhAtu) (quote (juhotyAdi))))
                  "Sap rejected on juhotyAdi without Slu")
    (assert-equal (quote ())
                  (ambiguous-apavada? dadati-rule-2-4-72 dadati-rule-2-4-75)
                  "declared dadAti priority is unambiguous")
    (assert-equal t
                  (ambiguous-apavada? incorrect-priority-pair-a incorrect-priority-pair-b)
                  "mutual apavAda declarations rejected as ambiguous")))

(def test-panini-core-syntax
  (lambda ()
    (assert-equal "1.4.54" (get-karaka (quote kartf) (quote sutra)) "core get-karaka sutra")
    (assert-equal (quote agent) (get-karaka (quote kartf) (quote semantic-role)) "core get-karaka role")
    (assert-equal (quote gam) (cdr (assoc (quote dhAtu) example-gam)) "core example-gam dhatu")
    (assert-equal (quote sTAlI)
                  (cdr (assoc (quote aDikaraRa) (cdr (assoc (quote kAraka-args) example-pac-full))))
                  "core example-pac-full aDikaraRa")
    (assert-equal 8 (cdr (assoc (quote class) (cdr (assoc (quote kf) dhatu-registry))))
                  "core dhatu-registry kf class")))

(def test-situated-karaka-membership
  (lambda ()
    (assert-equal (quote karaka-membership)
                  (karaka-membership-field example-pac-kartf-membership (quote kind))
                  "karaka membership record kind")
    (assert-equal (quote situation-pac-01)
                  (karaka-membership-field example-pac-kartf-membership (quote situation))
                  "karaka membership is situation-scoped")
    (assert-equal (quote kartf)
                  (karaka-membership-field example-pac-kartf-membership (quote karaka))
                  "karaka membership preserves Panini identifier")
    (assert-equal (quote devadatta)
                  (karaka-membership-field example-pac-kartf-membership (quote participant))
                  "karaka membership names situated participant")
    (assert-equal (quote prov:example:pacati)
                  (karaka-membership-field example-pac-kartf-membership (quote provenance))
                  "karaka membership carries provenance")
    (assert-equal (quote needs-check)
                  (karaka-membership-field example-pac-kartf-membership (quote status))
                  "karaka membership keeps uncertain status explicit")))

(def test-bavati-execution
  (lambda ()
    (assert-equal 7 (bavati-step-count (derive-Bavati))
                  "bavati executable step count")
    (assert-equal (quote partial) (bavati-status (derive-Bavati))
                  "bavati trace terminates partial")
    (assert-equal "3.2.123" (bavati-step-rule (bavati-step-at (derive-Bavati) 1))
                  "bavati step 1 rule")
    (assert-equal "6.1.78" (bavati-step-rule (bavati-step-at (derive-Bavati) 7))
                  "bavati step 7 rule")
    (assert-equal "state:bavati:bavati"
                  (bavati-step-after (bavati-step-at (derive-Bavati) 7))
                  "bavati step 7 after state")
    (assert-equal t
                  (member? "bridge-from-it-analysis-to-sarvadhatuka-precondition"
                           (bavati-unknowns-of (derive-Bavati)))
                  "bavati guna precondition unknown recorded")
    (assert-equal "Bavati" (concat-terms bavati-surface-terms)
                  "bavati observed surface form")))

(def run-tests
  (lambda ()
    (print "Running Panini Machine Tests...")
    (test-pratyahara)
    (test-eco-sandhi)
    (test-guna)
    (test-prototype-derivations)
    (test-dadati-declared-conflict)
    (test-karoti-derivation)
    (test-pacati-derivation)
    (test-anuvrtti-dag-edges)
    (test-negative-derivation-fixtures)
    (test-trace-canonical-serialization)
    (test-explanation-boundary)
    (test-panini-core-syntax)
    (test-situated-karaka-membership)
    (test-bavati-execution)
    (test-yaml-parser)
    (print "Tests complete.")))

(def test-yaml-parser
  (lambda ()
    ;; We expect *test-dhatu-registry* (populated via yaml-parser) to contain BU and others.
    ;; Check properties of 'BU
    (let ((bu (assoc (quote BU) *test-dhatu-registry*)))
      (let ((_ (assert-equal (quote 1) (cdr (assoc (quote class) (cdr bu))) "yaml parser extracted BU class 1")))
        (assert-equal (quote (parasmaipadin seT)) (cdr (assoc (quote properties) (cdr bu))) "yaml parser extracted BU parasmaipadin seT")))))

