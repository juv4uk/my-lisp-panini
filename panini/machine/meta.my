;; Panini Machine Model v0.1 — Meta-Level (Paribhāṣā)
;; Inference Engine: conflict resolution and rule dispatch.
;; All identifiers strictly use SLP1 encoding.
;;
;; This implements the paribhAzA hierarchy discovered in research:
;;   foundation/paribhasha.md
;;
;; Priority order (from academic sources, Unive.it 2024):
;;   1. antaraMga > bAhiraMga
;;   2. nitya     > anitya
;;   3. apavAda   > utsarga
;;   4. vipratiSeDe paraM kAryam (1.4.2) — DEFAULT

;; ==========================================
;; Anuvṛtti / Adhikāra Context Engine
;; ==========================================
;; DEPRECATED: dynamic binding (`with-adhikara`) was removed.
;; Anuvṛtti is now modeled as a static dependency graph via rule properties
;; `inherits-from` and `inherits-words`.
;; See: research/anuvrtti-graph-vs-dynamic-binding.md

;; ==========================================
;; Rule Object Structure
;; ==========================================
;; A rule is an a-list:
;;   id      — SLP1 sutra reference, e.g. "7.3.84"
;;   source  — provenance category, per specs/rule-provenance-schema.md
;;             (PANINI-RULE-PROVENANCE-SCHEMA). One of:
;;               sutra                    — direct Astadhyayi citation
;;               dhatupatha               — Dhatupatha entry, not Astadhyayi
;;               varttika                 — Katyayana's addendum (unused so far)
;;               commentary               — Kasika/Mahabhasya/etc (unused so far)
;;               traditional-principle    — inferred from commentarial
;;                                           tradition, not from a single
;;                                           sutra's own text (e.g. the
;;                                           antaraMga/bAhiraMga scope
;;                                           classification below, from
;;                                           paribhasha.md P3)
;;               implementation-convenience — our own engineering choice
;;               my-lisp-hypothesis       — our own architectural hypothesis
;;             IMPORTANT: an `id` being a real sutra number (source=sutra)
;;             does NOT make every other field on the same rule also
;;             `source=sutra` -- `scope`/`type` on a rule typically have
;;             their OWN, different provenance (see the annotated examples
;;             in rules.my for "7.3.84"/"6.1.78").
;;   scope   — antaraMga | bAhiraMga (default: bAhiraMga)
;;   type    — viDi | paribhAzA (default: viDi)
;;   nitya   — t | () (is this rule obligatory regardless of competition?)
;;   utsarga — nil or id of general rule this is exception to
;;   inherits-from  — sutra ID of the adhikara this rule inherits from (static graph)
;;   inherits-words — specific words inherited (anuvrtti)
;;   action  — lambda: prakriya → new-prakriya
;;   condition — lambda: prakriya → t | ()
;;
(def make-rule
  (lambda (id source scope nitya utsarga-id inherits-from inherits-words condition action)
    (list
      (cons 'id             id)
      (cons 'source         source)
      (cons 'scope          scope)
      (cons 'nitya          nitya)
      (cons 'utsarga        utsarga-id)
      (cons 'inherits-from  inherits-from)
      (cons 'inherits-words inherits-words)
      (cons 'condition      condition)
      (cons 'action         action))))

(def rule-id             (lambda (r) (cdr (assoc 'id             r))))
(def rule-source         (lambda (r) (cdr (assoc 'source         r))))
(def rule-scope          (lambda (r) (cdr (assoc 'scope          r))))
(def rule-nitya          (lambda (r) (cdr (assoc 'nitya          r))))
(def rule-utsarga        (lambda (r) (cdr (assoc 'utsarga        r))))
(def rule-inherits-from  (lambda (r) (cdr (assoc 'inherits-from  r))))
(def rule-inherits-words (lambda (r) (cdr (assoc 'inherits-words r))))
(def rule-condition      (lambda (r) (cdr (assoc 'condition      r))))
(def rule-action         (lambda (r) (cdr (assoc 'action         r))))

;; ==========================================
;; Sutra ID Comparison (for vipratiSeDa)
;; ==========================================
;; "7.3.84" → (7 3 84) for lexicographic comparison
;; We represent parsed ID as (adhyAya pada sutra)
;;
(def parse-sutra-id
  (lambda (id-str)
    ;; Simplified: assumes well-formed "X.Y.Z" string
    ;; In real My Lisp: would use string-split or similar
    ;; For now: store pre-parsed as list when defining rules
    id-str))

;; Compare two sutra IDs: returns t if a is later than b
;; IDs are stored as (adhyAya pada sutra) integer lists.
(def sutra-later?
  (lambda (id-a id-b)
    (let* ((a1 (car id-a))    (b1 (car id-b))
           (a2 (second id-a)) (b2 (second id-b))
           (a3 (third id-a))  (b3 (third id-b)))
      (cond
        ((> a1 b1) t)
        ((< a1 b1) '())
        ;; a1 = b1, compare pada
        ((> a2 b2) t)
        ((< a2 b2) '())
        ;; a1=b1, a2=b2, compare sutra
        ((> a3 b3) t)
        (t '())))))

;; ==========================================
;; Paribhāṣā Predicates
;; ==========================================

;; Tripādī check: rule belongs to chapters 8.2, 8.3, 8.4.
;; For v0.1 we provide a dummy returning '() since all our rules are Sapad.
(def tripadi?
  (lambda (rule)
    '()))

;; P3: antaraMga — a rule is "internal" if its conditions
;; are fully contained within the current aṅga (stem) domain.
;; For our purposes: a rule is antaraMga if it only references
;; the dhAtu itself, not the suffix.
(def antaraMga?
  (lambda (rule prakriya)
    (eq (rule-scope rule) 'antaraMga)))

;; P4: nitya — a rule is obligatory (nitya) regardless of
;; whether the competing rule is applied.
;; We store this as a boolean flag on the rule itself.
(def nitya?
  (lambda (rule prakriya)
    (rule-nitya rule)))

;; P2: apavAda — rule-a is an exception to rule-b if
;; rule-a's utsarga field names rule-b.
(def apavada-of?
  (lambda (rule-a rule-b)
    (eq (rule-utsarga rule-a) (rule-id rule-b))))

;; ==========================================
;; Core Conflict Resolution (paribhAzA Engine)
;; ==========================================
;;
;; resolve-conflict — implements the paribhAzA priority hierarchy.
;; Given two conflicting rules and the current derivation state,
;; returns the one rule that should be applied.
;;
;; [MY-LISP HYPOTHESIS] — formal model, not historical fact.
;;
(def resolve-conflict
  (lambda (rule-a rule-b prakriya)
    (cond
      ;; P3: antaraMga > bAhiraMga
      ((and (antaraMga? rule-a prakriya)
            (not (antaraMga? rule-b prakriya)))
       rule-a)
      ((and (antaraMga? rule-b prakriya)
            (not (antaraMga? rule-a prakriya)))
       rule-b)

      ;; P4: nitya > anitya
      ((and (nitya? rule-a prakriya)
            (not (nitya? rule-b prakriya)))
       rule-a)
      ((and (nitya? rule-b prakriya)
            (not (nitya? rule-a prakriya)))
       rule-b)

      ;; P2: apavAda > utsarga
      ((apavada-of? rule-a rule-b) rule-a)
      ((apavada-of? rule-b rule-a) rule-b)

      ;; P1: vipratiSeDe paraM kAryam (1.4.2) — DEFAULT
      ;; The later rule in azwADyAyI wins.
      ((sutra-later? (rule-id rule-a) (rule-id rule-b)) rule-a)
      (t rule-b))))

;; ==========================================
;; Inference Engine — Core Loop
;; ==========================================
;;
;; find-applicable-rules — returns all rules whose
;; condition matches the current prakriya state.
;;
(def find-applicable-rules
  (lambda (rule-list prakriya)
    (cond
      ((not rule-list) '())
      (((rule-condition (car rule-list)) prakriya)
       (cons (car rule-list)
             (find-applicable-rules (cdr rule-list) prakriya)))
      (t (find-applicable-rules (cdr rule-list) prakriya)))))

;;
;; apply-best-rule — from a list of applicable rules,
;; choose the highest-priority one via paribhAzA and apply it.
;;
(def apply-best-rule
  (lambda (applicable prakriya)
    (cond
      ((not applicable) prakriya)           ;; no rules → done
      ((not (cdr applicable))               ;; exactly one rule → apply it
       ((rule-action (car applicable)) prakriya))
      (t                                    ;; conflict → resolve
       (let* ((winner (resolve-conflict (car applicable)
                                        (second applicable)
                                        prakriya)))
         ((rule-action winner) prakriya))))))

;;
;; run-sapad-inference — Phase 1: cyclic application
;; Applies Sapad rules repeatedly until no more are applicable.
;; Returns final prakriya.
;;
(def run-sapad-inference
  (lambda (rule-list prakriya max-steps)
    (cond
      ((eq max-steps 0) prakriya)  ;; safety limit
      (t
       (let* ((applicable (find-applicable-rules rule-list prakriya)))
         (cond
           ((not applicable) prakriya)   ;; fixpoint reached
           (t
            (run-sapad-inference
              rule-list
              (apply-best-rule applicable prakriya)
              (- max-steps 1)))))))))

;;
;; run-tripadi-inference — Phase 2: strictly sequential application
;; Applies Tripadi rules exactly once in order of their sutra ID.
;; No cyclical feedback.
;;
(def run-tripadi-inference
  (lambda (rule-list prakriya)
    (cond
      ((not rule-list) prakriya)
      (t
       (let* ((rule (car rule-list))
              (applicable ((rule-condition rule) prakriya)))
         (run-tripadi-inference
           (cdr rule-list)
           (if applicable
               ((rule-action rule) prakriya)
               prakriya)))))))

;;
;; run-full-inference — Master Engine Loop
;;
(def run-full-inference
  (lambda (rule-list prakriya max-steps)
    ;; In a real implementation, we filter by `tripadi?` and sort Tripadi rules.
    ;; For v0.1, we assume all current rules are Sapad and Tripadi list is empty.
    (let* ((sapad-rules rule-list)
           (tripadi-rules '())
           (sapad-result (run-sapad-inference sapad-rules prakriya max-steps)))
      (run-tripadi-inference tripadi-rules sapad-result))))
