;; Verbal Derivation Engine — dhātu + vikaraṇa + tiṅ → surface form
;;
;; Supports: laṭ (present) + loṭ (imperative)
;;
;; Pipeline:
;;   1. it-lopa: remove it-markers from vikaraṇa and tiṅ (1.3.3 + 1.3.5 + 1.3.9)
;;      Special: jhi (Ji) → ādeśa "nti" (8.4.62) [laṭ only; loṭ has ntu pre-set]
;;   2. ṭere: substitute ta → te for ātmanepada when vikaraṇa has ṭit (3.4.79)
;;   3. vṛddhi: lengthen vikaraṇa final a→ā before 1st person tiṅ (7.3.101)
;;   4. guṇa/yaṇ: replace vowels based on class (7.3.84 + 6.4.87)
;;      Class 10 (Ṇic): guṇa on ALL vowels of aṅga (dhātu + "i")
;;      Class 1 (Śap):  guṇa on LAST vowel of dhātu
;;      Class 5 (Śnu):  guṇa on LAST vowel of aṅga (vikaraṇa "u") for 3sg/1sg
;;                      yaṇ (u→v) on LAST vowel of aṅga for 3pl + a-insertion
;;      Class 8 (u):    same as class 5 (guṇa/yaṇ split)
;;   5. eco sandhi: e/o → ay/av before vowel (6.1.78)
;;   6. savarṇa dīrgha: two homogeneous vowels → long (6.1.101)
;;   7. 8.4.55: jhalāṃ jhaśi — voiced → voiceless before voiceless
;;   8. concatenate
;;
;; Epistemic layer: ENGINEERING
;; Depends on: ting.my, phonology.my, sandhi.my
;; Journals: 0017, 0018, 0020 (laṭ), 0022 (loṭ + savarṇa dīrgha)
;;
;; SLP1 ENCODING NOTE:
;;   z=ś, S=ṣ, f=ṛ, R=ṇ (consonant), F=ṝ, A=ā, I=ī, U=ū
;;   Ṇic = (R i c): R=ṇ is ṇiṭ by 1.3.5, c=hal antyam by 1.3.3

(load "panini/machine/ting.my")

;; ==========================================
;; 7.3.101: vṛddhi — vikaraṇa final a→ā before 1st person tiṅ
;; ==========================================

(def first-person-ting?
  (lambda (ting-label)
    (or (equal? ting-label (quote mip))
        (equal? ting-label (quote vas))
        (equal? ting-label (quote mas)))))

(def vikarana-ends-in-a?
  (lambda (vik)
    (cond
      ((atom vik) (quote ()))
      ((atom (cdr vik)) (equal? (car vik) (quote a)))
      (t (vikarana-ends-in-a? (cdr vik))))))

(def replace-last-a
  (lambda (vik)
    (cond
      ((atom vik) (quote ()))
      ((atom (cdr vik))
       (cond
         ((equal? (car vik) (quote a)) (quote (A)))
         (t (list (car vik)))))
      (t (cons (car vik) (replace-last-a (cdr vik)))))))

(def apply-vrddhi
  (lambda (vikarana-clean ting-label)
    (cond
      ((and (first-person-ting? ting-label)
            (vikarana-ends-in-a? vikarana-clean))
       (replace-last-a vikarana-clean))
      (t vikarana-clean))))

;; Vṛddhi for Śap suffix (class 10): a→ā before 1st person
(def apply-suffix-vrddhi
  (lambda (suffix ting-label)
    (cond
      ((and (first-person-ting? ting-label)
            (equal? suffix (quote (a))))
       (quote (A)))
      (t suffix))))

;; ==========================================
;; Guṇa grade substitution (7.3.84)
;;
;; 7.3.84: sārvadhātukārdhadhātukayoḥ
;; Kāśikā: "sārvadhātuke ārdhadhātuke ca pratyaye parataḥ
;;          igantasya aṅgasya guṇo bhavati"
;; = guṇa of the aṅga occurs when sārvadhātuka suffix follows
;;
;; Class 10 (Ṇic): aṅga = dhātu + "i" → guṇa ALL vowels (7.2.115)
;; Class 1 (Śap):  aṅga = dhātu → guṇa LAST vowel of dhātu
;; Class 5 (Śnu):  aṅga = dhātu + "nu" → guṇa LAST vowel (vikaraṇa u→o)
;;   3pl: yaṇ (u→v) instead of guṇa, + a-insertion (6.4.87)
;; Class 8 (u):    aṅga = dhātu + "u" → same as class 5
;; ==========================================

(def apply-guRa-extended
  (lambda (sound)
    (cond
      ((equal? sound (quote U)) (quote o))
      ((equal? sound (quote u)) (quote o))
      ((equal? sound (quote I)) (quote e))
      ((equal? sound (quote i)) (quote e))
      ((equal? sound (quote F)) (quote ar))
      ((equal? sound (quote f)) (quote ar))
      ((equal? sound (quote X)) (quote al))
      ((equal? sound (quote x)) (quote al))
      (t sound))))

;; Yaṇ substitution (6.4.87 + 1.1.48): u→v, i→y, U→v, I→y
(def apply-yaR-extended
  (lambda (sound)
    (cond
      ((equal? sound (quote U)) (quote v))
      ((equal? sound (quote u)) (quote v))
      ((equal? sound (quote I)) (quote y))
      ((equal? sound (quote i)) (quote y))
      (t sound))))

;; Apply guṇa to ALL vowels in a sound list (for class 10 aṅga)
(def apply-guṇa-all-vowels
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      (t (cons (apply-guRa-extended (car sounds))
               (apply-guṇa-all-vowels (cdr sounds)))))))

;; Apply guṇa to LAST vowel only (for class 1 dhātu, or class 5/8 aṅga)
(def apply-guṇa-last-vowel
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (cond
         ((vowel? (car sounds))
          (list (apply-guRa-extended (car sounds))))
         (t (list (car sounds)))))
      (t (cons (car sounds)
               (apply-guṇa-last-vowel (cdr sounds)))))))

;; Apply yaṇ to LAST vowel only (for Śnu/Śu 3pl)
(def apply-yaṇ-last-vowel
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (cond
         ((vowel? (car sounds))
          (list (apply-yaR-extended (car sounds))))
         (t (list (car sounds)))))
      (t (cons (car sounds)
               (apply-yaṇ-last-vowel (cdr sounds)))))))

;; Apply guṇa/yaṇ to aṅga based on class and tiṅ
(def apply-guṇa-to-anga
  (lambda (dhatu vikarana-clean has-tit is-nic is-snu ting-label)
    (cond
      ((not has-tit) (append dhatu vikarana-clean))
      (is-nic
       (apply-guṇa-all-vowels (append dhatu vikarana-clean)))
      (is-snu
       (cond
         ((equal? ting-label (quote jhi))
          (apply-yaṇ-last-vowel (append dhatu vikarana-clean)))
         (t
          (apply-guṇa-last-vowel (append dhatu vikarana-clean)))))
      (t
       (append (apply-guṇa-last-vowel dhatu) vikarana-clean)))))

;; ==========================================
;; Eco sandhi expansion (6.1.78: iko yaṇ aci)
;; e/o + vowel → ay/av
;; ==========================================

(def expand-eco-in-list
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      (t
       ((lambda (s next)
          (cond
            ((and (equal? s (quote o)) (vowel? next))
             (cons (quote a) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote e)) (vowel? next))
             (cons (quote a) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote O)) (vowel? next))
             (cons (quote A) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote E)) (vowel? next))
             (cons (quote A) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            (t (cons s (expand-eco-in-list (cdr sounds))))))
        (car sounds)
        (cond
          ((atom (cdr sounds)) (quote ()))
          (t (car (cdr sounds)))))))))

;; ==========================================
;; 6.1.101: akas savarṇe dīrghaḥ
;; Two homogeneous adjacent vowels merge into the long form
;; a+a→ā, a+ā→ā, ā+a→ā, ā+ā→ā, i+i→ī, u+u→ū, etc.
;; ==========================================

(def savarṇa-pair?
  (lambda (s1 s2)
    (cond
      ;; a/A group
      ((and (equal? s1 (quote a)) (equal? s2 (quote a))) (quote A))
      ((and (equal? s1 (quote a)) (equal? s2 (quote A))) (quote A))
      ((and (equal? s1 (quote A)) (equal? s2 (quote a))) (quote A))
      ((and (equal? s1 (quote A)) (equal? s2 (quote A))) (quote A))
      ;; i/I group
      ((and (equal? s1 (quote i)) (equal? s2 (quote i))) (quote I))
      ((and (equal? s1 (quote i)) (equal? s2 (quote I))) (quote I))
      ((and (equal? s1 (quote I)) (equal? s2 (quote i))) (quote I))
      ((and (equal? s1 (quote I)) (equal? s2 (quote I))) (quote I))
      ;; u/U group
      ((and (equal? s1 (quote u)) (equal? s2 (quote u))) (quote U))
      ((and (equal? s1 (quote u)) (equal? s2 (quote U))) (quote U))
      ((and (equal? s1 (quote U)) (equal? s2 (quote u))) (quote U))
      ((and (equal? s1 (quote U)) (equal? s2 (quote U))) (quote U))
      ;; f/F group (r̥/r̥̄)
      ((and (equal? s1 (quote f)) (equal? s2 (quote f))) (quote F))
      ((and (equal? s1 (quote F)) (equal? s2 (quote f))) (quote F))
      ((and (equal? s1 (quote f)) (equal? s2 (quote F))) (quote F))
      ((and (equal? s1 (quote F)) (equal? s2 (quote F))) (quote F))
      (t (quote ())))))

(def apply-savarṇa-dīrgha
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds)) sounds)
      (t
       ((lambda (merged)
          (cond
            ((atom merged)
             ;; No merge: keep first, recurse on rest
             (cons (car sounds) (apply-savarṇa-dīrgha (cdr sounds))))
            (t
             ;; Merge: replace two sounds with merged, continue
             (cons merged (apply-savarṇa-dīrgha (cdr (cdr sounds)))))))
        (savarṇa-pair? (car sounds) (car (cdr sounds))))))))

;; ==========================================
;; 8.4.55: jhalāṃ jhaśi — voiced → voiceless before voiceless
;;
;; Voiced consonant (jhal) before voiceless (khar) → devoiced
;; ==========================================

(def devoice-sound
  (lambda (s)
    (cond
      ((equal? s (quote g)) (quote k))
      ((equal? s (quote G)) (quote K))
      ((equal? s (quote j)) (quote c))
      ((equal? s (quote J)) (quote C))
      ((equal? s (quote D)) (quote T))
      ((equal? s (quote d)) (quote t))
      ((equal? s (quote b)) (quote p))
      ((equal? s (quote B)) (quote P))
      ((equal? s (quote q)) (quote w))
      ((equal? s (quote Q)) (quote W))
      (t s))))

(def is-khar?
  (lambda (s)
    (or (equal? s (quote k))
        (equal? s (quote K))
        (equal? s (quote p))
        (equal? s (quote P))
        (equal? s (quote c))
        (equal? s (quote C))
        (equal? s (quote w))
        (equal? s (quote W))
        (equal? s (quote T))
        (equal? s (quote t))
        (equal? s (quote S))
        (equal? s (quote z))
        (equal? s (quote s)))))

(def apply-jhal-jhashi
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (list (car sounds)))
      (t
       ((lambda (cur nxt)
          (cond
            ((and (is-khar? nxt)
                  (not (equal? (devoice-sound cur) cur)))
             (cons (devoice-sound cur) (apply-jhal-jhashi (cdr sounds))))
            (t
             (cons cur (apply-jhal-jhashi (cdr sounds))))))
        (car sounds)
        (cond
          ((atom (cdr sounds)) (quote ()))
          (t (car (cdr sounds)))))))))

;; ==========================================
;; Main derivation function
;;
;; Pipeline: it-lopa → ṭere → vṛddhi → guṇa/yaṇ → eco → savarṇa → 8.4.55
;; ==========================================

(def derive-verb
  (lambda (dhatu class-num ting-label is-atmanepada)
    ;; Default lakāra: laṭ
    (derive-verb-lakara dhatu class-num ting-label is-atmanepada (quote laT))))

(def derive-verb-lakara
  (lambda (dhatu class-num ting-label is-atmanepada lakara)
    ((lambda (vikarana-clean has-tit is-nic is-snu)
       ((lambda (ting-clean)
          ((lambda (ting-final)
             ((lambda (vikarana-vrddhi)
                ((lambda (suffix)
                   ((lambda (anga-guna)
                      ((lambda (ting-with-prefix)
                         ((lambda (combined)
                            ;; Pipeline: eco → savarṇa dīrgha → 8.4.55
                            (apply-jhal-jhashi
                              (apply-savarṇa-dīrgha
                                (expand-eco-in-list combined))))
                          (append anga-guna (append suffix ting-with-prefix))))
                       (cond
                         ((and is-snu (equal? ting-label (quote jhi)))
                          (cons (quote a) ting-final))
                         (t ting-final))))
                    (apply-guṇa-to-anga dhatu vikarana-vrddhi has-tit is-nic is-snu ting-label)))
                 (cond
                   (is-nic
                    (apply-suffix-vrddhi (quote (a)) ting-label))
                   (t (quote ())))))
              (apply-vrddhi vikarana-clean ting-label)))
           (apply-tere ting-clean has-tit is-atmanepada)))
        (get-ting-para ting-label lakara)))
     (get-vikarana-clean class-num)
     (vikarana-has-tit? class-num)
     (is-nic-class? class-num)
     (is-snu-class? class-num))))

;; Convenience: loṭ derivation
(def derive-verb-lot
  (lambda (dhatu class-num ting-label)
    (derive-verb-lakara dhatu class-num ting-label (quote ()) (quote loT))))

;; ==========================================
;; laṅ (imperfect) — augment a- prefix
;;
;; 3.2.111: anadyatanaṃ laṅ (imperfect = not today)
;; 6.1.3+: chordasī... aṅgād... — augment a- prefixed to dhātu
;;
;; The augment a- is NOT part of the aṅga (no guṇa on it).
;; It is simply prepended to the final combined list.
;; savarṇa dīrgha (6.1.101) handles a+a→ā if dhātu starts with a.
;; eco sandhi (6.1.78) handles a+i→e, a+u→o if needed.
;; ==========================================

(def derive-verb-laN
  (lambda (dhatu class-num ting-label)
    ((lambda (result)
       ;; Prepend augment a- to the derived form, then re-apply sandhi
       ;; (savarṇa dīrgha for a+vowel, eco for a+i/u)
       (apply-jhal-jhashi
         (apply-savarṇa-dīrgha
           (expand-eco-in-list
             (cons (quote a) result)))))
     (derive-verb-lakara dhatu class-num ting-label (quote ()) (quote laN)))))

;; ==========================================
;; Convenience
;; ==========================================

(def derive-verb-string
  (lambda (dhatu class-num ting-label is-atmanepada)
    (symbol-list->string (derive-verb dhatu class-num ting-label is-atmanepada))))

;; === laṭ (present) named derivations ===

(def derive-pacati    (lambda () (derive-verb (quote (p a c)) 6 (quote tip) (quote ()))))
(def derive-bhavati   (lambda () (derive-verb (quote (b h U)) 1 (quote tip) (quote ()))))
(def derive-sunoti    (lambda () (derive-verb (quote (s u)) 5 (quote tip) (quote ()))))
(def derive-tanoti    (lambda () (derive-verb (quote (t a n)) 8 (quote tip) (quote ()))))
(def derive-corayati  (lambda () (derive-verb (quote (c u r)) 10 (quote tip) (quote ()))))
(def derive-nayati    (lambda () (derive-verb (quote (n I)) 1 (quote tip) (quote ()))))
(def derive-pazyati   (lambda () (derive-verb (quote (p a z)) 4 (quote tip) (quote ()))))
(def derive-kfSati    (lambda () (derive-verb (quote (k f S)) 6 (quote tip) (quote ()))))
(def derive-stavati   (lambda () (derive-verb (quote (s t u)) 1 (quote tip) (quote ()))))
(def derive-kroSayati (lambda () (derive-verb (quote (k r u S)) 10 (quote tip) (quote ()))))

(def derive-bhavAmi   (lambda () (derive-verb (quote (b h U)) 1 (quote mip) (quote ()))))
(def derive-sunomi    (lambda () (derive-verb (quote (s u)) 5 (quote mip) (quote ()))))
(def derive-corayAmi  (lambda () (derive-verb (quote (c u r)) 10 (quote mip) (quote ()))))

(def derive-bhavanti  (lambda () (derive-verb (quote (b h U)) 1 (quote jhi) (quote ()))))
(def derive-sunvanti  (lambda () (derive-verb (quote (s u)) 5 (quote jhi) (quote ()))))
(def derive-corayanti (lambda () (derive-verb (quote (c u r)) 10 (quote jhi) (quote ()))))

;; === loṭ (imperative) named derivations ===

(def derive-bhavatu   (lambda () (derive-verb-lot (quote (b h U)) 1 (quote tip))))
(def derive-sunotu    (lambda () (derive-verb-lot (quote (s u)) 5 (quote tip))))
(def derive-tanotu    (lambda () (derive-verb-lot (quote (t a n)) 8 (quote tip))))
(def derive-corayatu  (lambda () (derive-verb-lot (quote (c u r)) 10 (quote tip))))
(def derive-pacatu    (lambda () (derive-verb-lot (quote (p a c)) 6 (quote tip))))
(def derive-nayatu    (lambda () (derive-verb-lot (quote (n I)) 1 (quote tip))))

(def derive-bhavantu  (lambda () (derive-verb-lot (quote (b h U)) 1 (quote jhi))))
(def derive-sunvantu  (lambda () (derive-verb-lot (quote (s u)) 5 (quote jhi))))
(def derive-corayantu (lambda () (derive-verb-lot (quote (c u r)) 10 (quote jhi))))
(def derive-pacantu   (lambda () (derive-verb-lot (quote (p a c)) 6 (quote jhi))))

(def derive-bhava     (lambda () (derive-verb-lot (quote (b h U)) 1 (quote sip))))
(def derive-paca      (lambda () (derive-verb-lot (quote (p a c)) 6 (quote sip))))
(def derive-suno      (lambda () (derive-verb-lot (quote (s u)) 5 (quote sip))))
(def derive-coraya    (lambda () (derive-verb-lot (quote (c u r)) 10 (quote sip))))

(def derive-bhavAni   (lambda () (derive-verb-lot (quote (b h U)) 1 (quote mip))))
(def derive-pacAni    (lambda () (derive-verb-lot (quote (p a c)) 6 (quote mip))))
(def derive-corayAni  (lambda () (derive-verb-lot (quote (c u r)) 10 (quote mip))))

;; === laṅ (imperfect) named derivations ===

(def derive-abhavat   (lambda () (derive-verb-laN (quote (b h U)) 1 (quote tip))))
(def derive-apacat    (lambda () (derive-verb-laN (quote (p a c)) 6 (quote tip))))
(def derive-asunot    (lambda () (derive-verb-laN (quote (s u)) 5 (quote tip))))
(def derive-atanot    (lambda () (derive-verb-laN (quote (t a n)) 8 (quote tip))))
(def derive-acorayat  (lambda () (derive-verb-laN (quote (c u r)) 10 (quote tip))))
(def derive-anayat    (lambda () (derive-verb-laN (quote (n I)) 1 (quote tip))))
(def derive-apazyat  (lambda () (derive-verb-laN (quote (p a z)) 4 (quote tip))))
(def derive-akfSat   (lambda () (derive-verb-laN (quote (k f S)) 6 (quote tip))))

(def derive-abhavan   (lambda () (derive-verb-laN (quote (b h U)) 1 (quote jhi))))
(def derive-apacan    (lambda () (derive-verb-laN (quote (p a c)) 6 (quote jhi))))
(def derive-asunvan   (lambda () (derive-verb-laN (quote (s u)) 5 (quote jhi))))
(def derive-acorayan  (lambda () (derive-verb-laN (quote (c u r)) 10 (quote jhi))))

(def derive-abhavam   (lambda () (derive-verb-laN (quote (b h U)) 1 (quote mip))))
(def derive-apacam   (lambda () (derive-verb-laN (quote (p a c)) 6 (quote mip))))
(def derive-acorayam  (lambda () (derive-verb-laN (quote (c u r)) 10 (quote mip))))
