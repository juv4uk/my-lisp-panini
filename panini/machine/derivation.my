;; Verbal Derivation Engine — dhātu + vikaraṇa + tiṅ → surface form
;;
;; Combines the tiṅ system, vikaraṇa table, guṇa grade, and eco sandhi
;; to produce surface verbal forms.
;;
;; Pipeline:
;;   1. it-lopa: remove it-markers from vikaraṇa and tiṅ (1.3.3 + 1.3.5 + 1.3.9)
;;   2. ṭere: substitute ta → te for ātmanepada when vikaraṇa has ṭit (3.3.79)
;;   3. guṇa: replace dhātu vowel with guṇa grade when vikaraṇa has ṭit (7.3.84)
;;   4. eco sandhi: e/o → ay/av before vowel (6.1.88)
;;   5. concatenate
;;
;; Epistemic layer: ENGINEERING
;; Depends on: ting.my, phonology.my, sandhi.my
;; Upstream: SS-PRATYAHARA-001, L-001-001

(load "panini/machine/ting.my")

;; ==========================================
;; Guṇa grade substitution (7.3.84, simplified)
;; Applied to dhātu's final vowel when vikaraṇa has ṭit.
;; Uses apply-guRa from phonology.my.
;; ==========================================

(def apply-guṇa-to-dhatu
  (lambda (dhatu-sounds has-tit)
    (cond
      ((not has-tit) dhatu-sounds)  ;; no ṭit → no guṇa
      ((atom dhatu-sounds) dhatu-sounds)
      (t (cons (car dhatu-sounds)
               (apply-guṇa-to-dhatu-rest (cdr dhatu-sounds) (car dhatu-sounds)))))))

;; Helper: find and replace the last vowel in the list
(def apply-guṇa-to-dhatu-rest
  (lambda (rest prev)
    (cond
      ((atom rest) (quote ()))  ;; no more sounds — prev was last, but not a vowel
      ((atom (cdr rest))
       ;; Current sound is last — check if it's a vowel
       (cond
         ((vowel? (car rest))
          ;; Replace last vowel with guṇa grade
          (cond
            ((equal? (apply-guRa (car rest)) (car rest)) (list (car rest)))  ;; no change
            (t (list (apply-guRa (car rest))))))
         (t (list (car rest)))))  ;; last is not vowel, no guṇa
      (t (cons (car rest)
               (apply-guṇa-to-dhatu-rest (cdr rest) (car rest)))))))

;; ==========================================
;; Eco sandhi expansion (6.1.88)
;; e → (a y), o → (a v), E → (A y), O → (A v) before vowel
;; Applied to the full combined sound list.
;; ==========================================

(def expand-eco-in-list
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      (t
       ((lambda (s next)
          (cond
            ((and (equal? s (quote o)) (vowel? next))
             (cons (quote a) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote e)) (vowel? next))
             (cons (quote a) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote O)) (vowel? next))
             (cons (quote A) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote E)) (vowel? next))
             (cons (quote A) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            (t (cons s (expand-eco-in-list (cdr sounds))))))
        (car sounds)
        (cond
          ((atom (cdr sounds)) (quote ()))  ;; no next
          (t (car (cdr sounds)))))))))

;; ==========================================
;; Main derivation function
;;
;; derive-verb: dhātu-sounds, class-num, ting-label, is-atmanepada → sound list
;;
;; Example:
;;   (derive-verb (quote (p a c)) 6 (quote tip) (quote ()))
;;   → (p a c a t i)   ;; "pacati"
;;
;;   (derive-verb (quote (b h U)) 1 (quote tip) (quote ()))
;;   → (b h a v a t i) ;; "bhavati"
;;
;;   (derive-verb (quote (l a b h)) 1 (quote ta) t)
;;   → (l a b h a t e) ;; "labhate"
;; ==========================================

(def derive-verb
  (lambda (dhatu class-num ting-label is-atmanepada)
    ((lambda (vikarana-clean has-tit ting-raw)
       ((lambda (ting-clean)
          ((lambda (ting-final)
             ((lambda (dhatu-guṇa)
                ((lambda (combined)
                   (expand-eco-in-list combined))
                 (append dhatu-guṇa (append vikarana-clean ting-final))))
              (apply-guṇa-to-dhatu dhatu has-tit)))
           (apply-tere ting-clean has-tit is-atmanepada)))
        (cond
          (is-atmanepada (apply-hal-antyam-lopa (ting-lookup ting-label ting-atmanepada)))
          (t (apply-hal-antyam-lopa (ting-lookup ting-label ting-parasmaipada))))))
     (get-vikarana-clean class-num)
     (vikarana-has-tit? class-num)
     ting-label)))

;; ==========================================
;; Convenience: derive to string
;; ==========================================

(def derive-verb-string
  (lambda (dhatu class-num ting-label is-atmanepada)
    (symbol-list->string (derive-verb dhatu class-num ting-label is-atmanepada))))

;; ==========================================
;; Named derivations
;; ==========================================

(def derive-pacati
  (lambda ()
    (derive-verb (quote (p a c)) 6 (quote tip) (quote ()))))

(def derive-bhavati
  (lambda ()
    (derive-verb (quote (b h U)) 1 (quote tip) (quote ()))))

(def derive-labhate
  (lambda ()
    (derive-verb (quote (l a b h)) 1 (quote ta) t)))

(def derive-tudati
  (lambda ()
    (derive-verb (quote (t u d)) 6 (quote tip) (quote ()))))
