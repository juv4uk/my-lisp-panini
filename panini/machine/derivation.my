;; Verbal Derivation Engine — dhātu + vikaraṇa + tiṅ → surface form
;;
;; Combines the tiṅ system, vikaraṇa table, guṇa grade, vṛddhi,
;; and eco sandhi to produce surface verbal forms.
;;
;; Pipeline:
;;   1. it-lopa: remove it-markers from vikaraṇa and tiṅ (1.3.3 + 1.3.5 + 1.3.9)
;;   2. ṭere: substitute ta → te for ātmanepada when vikaraṇa has ṭit (3.4.79)
;;   3. vṛddhi: lengthen vikaraṇa a→ā before 1st person tiṅ (7.3.101)
;;   4. guṇa: replace dhātu vowel with guṇa grade when vikaraṇa has ṭit (7.3.84)
;;   5. eco sandhi: e/o → ay/av before vowel (6.1.88)
;;   6. concatenate
;;
;; Epistemic layer: ENGINEERING
;; Depends on: ting.my, phonology.my, sandhi.my
;; Upstream: SS-PRATYAHARA-001, L-001-001

(load "panini/machine/ting.my")

;; ==========================================
;; 7.3.101: vṛddhi — vikaraṇa a→ā before 1st person tiṅ
;;
;; The 1st person tiṅ endings (mip, vas, mas → mi, va, ma after it-lopa)
;; trigger lengthening of the immediately preceding vikaraṇa vowel 'a' → 'ā'.
;;
;; Examples:
;;   pac + a + mi → pacāmi    (not pacami)
;;   bhav + a + mi → bhavāmi  (not bhavami)
;;   tud + a + mi → tudāmi    (not tudami)
;; ==========================================

(def first-person-ting?
  (lambda (ting-label)
    (or (equal? ting-label (quote mip))
        (equal? ting-label (quote vas))
        (equal? ting-label (quote mas)))))

(def apply-vrddhi
  (lambda (vikarana-clean ting-label)
    (cond
      ((and (first-person-ting? ting-label)
            (equal? vikarana-clean (quote (a))))
       (quote (A)))
      (t vikarana-clean))))

;; ==========================================
;; Guṇa grade substitution (7.3.84, simplified)
;; Applied to dhātu's final vowel when vikaraṇa has ṭit.
;; Uses apply-guRa from phonology.my.
;; ==========================================

(def apply-guṇa-to-dhatu
  (lambda (dhatu-sounds has-tit)
    (cond
      ((not has-tit) dhatu-sounds)
      ((atom dhatu-sounds) dhatu-sounds)
      (t (cons (car dhatu-sounds)
               (apply-guṇa-to-dhatu-rest (cdr dhatu-sounds) (car dhatu-sounds))))))

(def apply-guṇa-to-dhatu-rest
  (lambda (rest prev)
    (cond
      ((atom rest) (quote ()))
      ((atom (cdr rest))
       (cond
         ((vowel? (car rest))
          (cond
            ((equal? (apply-guRa (car rest)) (car rest)) (list (car rest)))
            (t (list (apply-guRa (car rest))))))
         (t (list (car rest)))))
      (t (cons (car rest)
               (apply-guṇa-to-dhatu-rest (cdr rest) (car rest)))))))

;; ==========================================
;; Eco sandhi expansion (6.1.88)
;; ==========================================

(def expand-eco-in-list
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      (t
       ((lambda (s next)
          (cond
            ((and (equal? s (quote o)) (vowel? next))
             (cons (quote a) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote e)) (vowel? next))
             (cons (quote a) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote O)) (vowel? next))
             (cons (quote A) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote E)) (vowel? next))
             (cons (quote A) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            (t (cons s (expand-eco-in-list (cdr sounds))))))
        (car sounds)
        (cond
          ((atom (cdr sounds)) (quote ()))
          (t (car (cdr sounds)))))))))

;; ==========================================
;; Main derivation function
;;
;; derive-verb: dhātu-sounds, class-num, ting-label, is-atmanepada → sound list
;;
;; Pipeline: it-lopa → ṭere → vṛddhi → guṇa → eco → concat
;; ==========================================

(def derive-verb
  (lambda (dhatu class-num ting-label is-atmanepada)
    ((lambda (vikarana-clean has-tit)
       ((lambda (ting-clean)
          ((lambda (ting-final)
             ((lambda (vikarana-vrddhi)
                ((lambda (dhatu-guṇa)
                   ((lambda (combined)
                      (expand-eco-in-list combined))
                     (append dhatu-guṇa (append vikarana-vrddhi ting-final))))
                  (apply-guṇa-to-dhatu dhatu has-tit)))
              (apply-vrddhi vikarana-clean ting-label)))
           (apply-tere ting-clean has-tit is-atmanepada)))
        (cond
          (is-atmanepada (apply-hal-antyam-lopa (ting-lookup ting-label ting-atmanepada)))
          (t (apply-hal-antyam-lopa (ting-lookup ting-label ting-parasmaipada))))))
     (get-vikarana-clean class-num)
     (vikarana-has-tit? class-num))))

;; ==========================================
;; Convenience: derive to string
;; ==========================================

(def derive-verb-string
  (lambda (dhatu class-num ting-label is-atmanepada)
    (symbol-list->string (derive-verb dhatu class-num ting-label is-atmanepada))))

;; ==========================================
;; Named derivations
;; ==========================================

(def derive-pacati
  (lambda ()
    (derive-verb (quote (p a c)) 6 (quote tip) (quote ()))))

(def derive-bhavati
  (lambda ()
    (derive-verb (quote (b h U)) 1 (quote tip) (quote ()))))

(def derive-labhate
  (lambda ()
    (derive-verb (quote (l a b h)) 1 (quote ta) t)))

(def derive-tudati
  (lambda ()
    (derive-verb (quote (t u d)) 6 (quote tip) (quote ()))))

;; 1st person forms (with vṛddhi)
(def derive-pacAmi
  (lambda ()
    (derive-verb (quote (p a c)) 6 (quote mip) (quote ()))))

(def derive-bhavAmi
  (lambda ()
    (derive-verb (quote (b h U)) 1 (quote mip) (quote ()))))

(def derive-tudAmi
  (lambda ()
    (derive-verb (quote (t u d)) 6 (quote mip) (quote ()))))
