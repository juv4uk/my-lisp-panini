;; Verbal Derivation Engine ‚Äî dhƒÅtu + vikara·πáa + ti·πÖ ‚Üí surface form
;;
;; Supports: la·π≠ (present) + lo·π≠ (imperative)
;;
;; Pipeline:
;;   1. it-lopa: remove it-markers from vikara·πáa and ti·πÖ (1.3.3 + 1.3.5 + 1.3.9)
;;      Special: jhi (Ji) ‚Üí ƒÅde≈õa "nti" (8.4.62) [la·π≠ only; lo·π≠ has ntu pre-set]
;;   2. ·π≠ere: substitute ta ‚Üí te for ƒÅtmanepada when vikara·πáa has ·π≠it (3.4.79)
;;   3. v·πõddhi: lengthen vikara·πáa final a‚ÜíƒÅ before 1st person ti·πÖ (7.3.101)
;;   4. gu·πáa/ya·πá: replace vowels based on class (7.3.84 + 6.4.87)
;;      Class 10 (·πÜic): gu·πáa on ALL vowels of a·πÖga (dhƒÅtu + "i")
;;      Class 1 (≈öap):  gu·πáa on LAST vowel of dhƒÅtu
;;      Class 5 (≈önu):  gu·πáa on LAST vowel of a·πÖga (vikara·πáa "u") for 3sg/1sg
;;                      ya·πá (u‚Üív) on LAST vowel of a·πÖga for 3pl + a-insertion
;;      Class 8 (u):    same as class 5 (gu·πáa/ya·πá split)
;;   5. eco sandhi: e/o ‚Üí ay/av before vowel (6.1.78)
;;   6. savar·πáa dƒ´rgha: two homogeneous vowels ‚Üí long (6.1.101)
;;   7. 8.4.55: jhalƒÅ·πÉ jha≈õi ‚Äî voiced ‚Üí voiceless before voiceless
;;   8. concatenate
;;
;; Epistemic layer: ENGINEERING
;; Depends on: ting.my, phonology.my, sandhi.my
;; Journals: 0017, 0018, 0020 (la·π≠), 0022 (lo·π≠ + savar·πáa dƒ´rgha)
;;
;; SLP1 ENCODING NOTE:
;;   z=≈õ, S=·π£, f=·πõ, R=·πá (consonant), F=·πù, A=ƒÅ, I=ƒ´, U=≈´
;;   ·πÜic = (R i c): R=·πá is ·πái·π≠ by 1.3.5, c=hal antyam by 1.3.3

(load "panini/machine/ting.my")

;; ==========================================
;; 7.3.101: v·πõddhi ‚Äî vikara·πáa final a‚ÜíƒÅ before 1st person ti·πÖ
;; ==========================================

(def first-person-ting?
  (lambda (ting-label)
    (or (equal? ting-label (quote mip))
        (equal? ting-label (quote vas))
        (equal? ting-label (quote mas)))))

(def vikarana-ends-in-a?
  (lambda (vik)
    (cond
      ((atom vik) (quote ()))
      ((atom (cdr vik)) (equal? (car vik) (quote a)))
      (t (vikarana-ends-in-a? (cdr vik))))))

(def replace-last-a
  (lambda (vik)
    (cond
      ((atom vik) (quote ()))
      ((atom (cdr vik))
       (cond
         ((equal? (car vik) (quote a)) (quote (A)))
         (t (list (car vik)))))
      (t (cons (car vik) (replace-last-a (cdr vik)))))))

(def apply-vrddhi
  (lambda (vikarana-clean ting-label)
    (cond
      ((and (first-person-ting? ting-label)
            (vikarana-ends-in-a? vikarana-clean))
       (replace-last-a vikarana-clean))
      (t vikarana-clean))))

;; V·πõddhi for ≈öap suffix (class 10): a‚ÜíƒÅ before 1st person
(def apply-suffix-vrddhi
  (lambda (suffix ting-label)
    (cond
      ((and (first-person-ting? ting-label)
            (equal? suffix (quote (a))))
       (quote (A)))
      (t suffix))))

;; ==========================================
;; Gu·πáa grade substitution (7.3.84)
;;
;; 7.3.84: sƒÅrvadhƒÅtukƒÅrdhadhƒÅtukayo·∏•
;; KƒÅ≈õikƒÅ: "sƒÅrvadhƒÅtuke ƒÅrdhadhƒÅtuke ca pratyaye parata·∏•
;;          igantasya a·πÖgasya gu·πáo bhavati"
;; = gu·πáa of the a·πÖga occurs when sƒÅrvadhƒÅtuka suffix follows
;;
;; Class 10 (·πÜic): a·πÖga = dhƒÅtu + "i" ‚Üí gu·πáa ALL vowels (7.2.115)
;; Class 1 (≈öap):  a·πÖga = dhƒÅtu ‚Üí gu·πáa LAST vowel of dhƒÅtu
;; Class 5 (≈önu):  a·πÖga = dhƒÅtu + "nu" ‚Üí gu·πáa LAST vowel (vikara·πáa u‚Üío)
;;   3pl: ya·πá (u‚Üív) instead of gu·πáa, + a-insertion (6.4.87)
;; Class 8 (u):    a·πÖga = dhƒÅtu + "u" ‚Üí same as class 5
;; ==========================================

(def apply-guRa-extended
  (lambda (sound)
    (cond
      ((equal? sound (quote U)) (quote o))
      ((equal? sound (quote u)) (quote o))
      ((equal? sound (quote I)) (quote e))
      ((equal? sound (quote i)) (quote e))
      ((equal? sound (quote F)) (quote ar))
      ((equal? sound (quote f)) (quote ar))
      ((equal? sound (quote X)) (quote al))
      ((equal? sound (quote x)) (quote al))
      (t sound))))

;; Ya·πá substitution (6.4.87 + 1.1.48): u‚Üív, i‚Üíy, U‚Üív, I‚Üíy
(def apply-yaR-extended
  (lambda (sound)
    (cond
      ((equal? sound (quote U)) (quote v))
      ((equal? sound (quote u)) (quote v))
      ((equal? sound (quote I)) (quote y))
      ((equal? sound (quote i)) (quote y))
      (t sound))))

;; Apply gu·πáa to ALL vowels in a sound list (for class 10 a·πÖga)
(def apply-gu·πáa-all-vowels
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      (t (cons (apply-guRa-extended (car sounds))
               (apply-gu·πáa-all-vowels (cdr sounds)))))))

;; Apply gu·πáa to LAST vowel only (for class 1 dhƒÅtu, or class 5/8 a·πÖga)
(def apply-gu·πáa-last-vowel
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (cond
          (vowel? (car sounds))
          (list (apply-guRa-extended (car sounds))))
         (t (list (car sounds)))))
      (t (cons (car sounds)
               (apply-gu·πáa-last-vowel (cdr sounds)))))))

;; Apply ya·πá to LAST vowel only (for ≈önu/≈öu 3pl)
(def apply-ya·πá-last-vowel
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (cond
         ((vowel? (car sounds))
          (list (apply-yaR-extended (car sounds))))
         (t (list (car sounds)))))
      (t (cons (car sounds)
               (apply-ya·πá-last-vowel (cdr sounds)))))))

;; Apply gu·πáa/ya·πá to a·πÖga based on class and ti·πÖ
(def apply-gu·πáa-to-anga
  (lambda (dhatu vikarana-clean has-tit is-nic is-snu ting-label)
    (cond
      ((not has-tit) (append dhatu vikarana-clean))
      (is-nic
       (apply-gu·πáa-all-vowels (append dhatu vikarana-clean)))
      (is-snu
       (cond
         ((equal? ting-label (quote jhi))
          (apply-ya·πá-last-vowel (append dhatu vikarana-clean)))
         (t
          (apply-gu·πáa-last-vowel (append dhatu vikarana-clean)))))
      (t
       (append (apply-gu·πáa-last-vowel dhatu) vikarana-clean)))))

;; ==========================================
;; Eco sandhi expansion (6.1.78: iko ya·πá aci)
;; e/o + vowel ‚Üí ay/av
;; ==========================================

(def expand-eco-in-list
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      (t
       ((lambda (s next)
          (cond
            ((and (equal? s (quote o)) (vowel? next))
             (cons (quote a) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote e)) (vowel? next))
             (cons (quote a) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote O)) (vowel? next))
             (cons (quote A) (cons (quote v) (expand-eco-in-list (cdr sounds)))))
            ((and (equal? s (quote E)) (vowel? next))
             (cons (quote A) (cons (quote y) (expand-eco-in-list (cdr sounds)))))
            (t (cons s (expand-eco-in-list (cdr sounds))))))
        (car sounds)
        (cond
          ((atom (cdr sounds)) (quote ()))
          (t (car (cdr sounds)))))))))

;; ==========================================
;; 6.1.101: akas savar·πáe dƒ´rgha·∏•
;; Two homogeneous adjacent vowels merge into the long form
;; a+a‚ÜíƒÅ, a+ƒÅ‚ÜíƒÅ, ƒÅ+a‚ÜíƒÅ, ƒÅ+ƒÅ‚ÜíƒÅ, i+i‚Üíƒ´, u+u‚Üí≈´, etc.
;; ==========================================

(def savar·πáa-pair?
  (lambda (s1 s2)
    (cond
      ;; a/A group
      ((and (equal? s1 (quote a)) (equal? s2 (quote a))) (quote A))
      ((and (equal? s1 (quote a)) (equal? s2 (quote A))) (quote A))
      ((and (equal? s1 (quote A)) (equal? s2 (quote a))) (quote A))
      ((and (equal? s1 (quote A)) (equal? s2 (quote A))) (quote A))
      ;; i/I group
      ((and (equal? s1 (quote i)) (equal? s2 (quote i))) (quote I))
      ((and (equal? s1 (quote i)) (equal? s2 (quote I))) (quote I))
      ((and (equal? s1 (quote I)) (equal? s2 (quote i))) (quote I))
      ((and (equal? s1 (quote I)) (equal? s2 (quote I))) (quote I))
      ;; u/U group
      ((and (equal? s1 (quote u)) (equal? s2 (quote u))) (quote U))
      ((and (equal? s1 (quote u)) (equal? s2 (quote U))) (quote U))
      ((and (equal? s1 (quote U)) (equal? s2 (quote u))) (quote U))
      ((and (equal? s1 (quote U)) (equal? s2 (quote U))) (quote U))
      ;; f/F group (rÃ•/rÃ•ÃÑ)
      ((and (equal? s1 (quote f)) (equal? s2 (quote f))) (quote F))
      ((and (equal? s1 (quote F)) (equal? s2 (quote f))) (quote F))
      ((and (equal? s1 (quote f)) (equal? s2 (quote F))) (quote F))
      ((and (equal? s1 (quote F)) (equal? s2 (quote F))) (quote F))
      (t (quote ())))))

(def apply-savar·πáa-dƒ´rgha
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds)) sounds)
      (t
       ((lambda (merged)
          (cond
            ((atom merged)
             ;; No merge: keep first, recurse on rest
             (cons (car sounds) (apply-savar·πáa-dƒ´rgha (cdr sounds))))
            (t
             ;; Merge: replace two sounds with merged, continue
             (cons merged (apply-savar·πáa-dƒ´rgha (cdr (cdr sounds)))))))
        (savar·πáa-pair? (car sounds) (car (cdr sounds))))*))

;; ==========================================
;; 8.4.55: jjal-jhashi ‚Äî voiced ‚Üí voiceless before voiceless
;;
;; Voiced consonant (jhal) before voiceless (khar) ‚Üí devoiced
;; ==========================================

(def devoice-sound
  (lambda (s)
    (cond
      ((equal? s (quote g)) (quote k))
      ((equal? s (quote G)) (quote K))
      ((equal? s (quote j)) (quote c))
      ((equal? s (quote J)) (quote C))
      ((equal? s (quote D)) (quote T))
      ((equal? s (quote d)) (quote t))
      ((equal? s (quote b)) (quote p))
      ((equal? s (quote B)) (quote P))
      ((equal? s (quote q)) (quote w))
      ((equal? s (quote Q)) (quote W))
      (t s))))

(def is-khar?
  (lambda (s)
    (or (equal? s (quote k))
        (equal? s (quote K))
        (equal? s (quote p))
        (equal? s (quote P))
        (equal? s (quote c))
        (equal? s (quote C))
        (equal? s (quote w))
        (equal? s (quote W))
        (equal? s (quote T))
        (equal? s (quote t))
        (equal? s (quote S))
        (equal? s (quote z))
        (equal? s (quote s))*))

(def apply-jhal-jhashi
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (list (car sounds)))
      (t
       ((lambda (cur nxt)
          (cond
            ((and (is-khar? nxt)
                  (not (equal? (devoice-sound cur) cur)))
             (cons (devoice-sound cur) (apply-jhal-jhashi (cdr sounds))))
            (t
             (cons cur (apply-jhal-jhashi (cdr sounds)))*)))
        (car sounds)
        (cond
          ((atom (cdr sounds)) (quote ()))
          (t (car (cdr sounds)))))*)))

;; ==========================================
;; Main derivation function
;;
;; Pipeline: it-lopa‚Üí ·π≠ere ‚Üí v·πõddhi ‚Üí gu·πáa/ya·πá ‚Üí eco ‚Üí savar·πáa ‚Üí 8.4.55
;; ==========================================

(def derive-verb
  (lambda (dhatu class-num ting-label is-atmanepada)
    ;; Default lakƒÅra: la·π≠
    (derive-verb-lakara dhatu class-num ting-label is-atmanepada (quote laT))))

(def derive-verb-lakara
  (lambda (dhatu class-num ting-label is-atmanepada lakara)
    ((lambda (vikarana-clean has-tit is-nic is-snu)
       ((lambda (ting-clean)
          ((lambda (ting-final)
             ((lambda (vikarana-vrddhi)
                 (lambda (suffix)
                   ((lambda (anga-guna)
                      ((lambda (ting-with-prefix)
                         ((lambda (combined)
                            ;; Pipeline: eco ‚Üí savar·πáa dƒ´rgha ‚Üí 8.4.55
                            (apply-jhal-jhashi
                              (apply-savar·πáa-dƒ´rgha
                                (expand-eco-in-list combined))))
                          (append anga-guna (append suffix ting-with-prefix))))
                       (cond
                         ((and is-snu (equal? ting-label (quote jhi)))
                          (cons (quote a) ting-final))
                         (t ting-final))))
                    (apply-gu·πáa-to-anga dhatu vikarana-vrddhi has-tit is-nic is-snu ting-label)))
                 (cond
                   (is-nic
                    ;; No suffix v·πõddhi in la·πÖ (ti·πÖ lack -i, 7.3.101 not triggered)
                    (cond
                      ((equal? lakara (quote laN)) (quote (a)))
                      (t (apply-suffix-vrddhi (quote (a)) ting-label))))
                   (t (quote ())))))
              ;; v·πõddhi: vikara·πáa a‚ÜíƒÅ before 1st person ‚Äî NOT in la·πÖ!
              (cond
                ((equal? lakara (quote laN)) vikarana-clean)
                (t (apply-vrddhi vikarana-clean ting-label)))))
           (apply-tere ting-clean has-tit is-atmanepada)))
        (get-ting-para ting-label lakara)))
     (get-vikarana-clean class-num)
     (vikarana-has-tit? class-num)
     (is-nic-class? class-num)
     (is-snu-class? class-num))))

;; Convenience: lo·π≠ derivation

(def derive-verb-lot
  (lambda (dhatu class-num ting-label)
    (derive-verb-lakara dhatu class-num ting-label (quote ()) (quote loT))))

;; ===========================================
;; la·πÖ (imperfect)‚Üí augment a- prefix
;;
;; 3.2.111: anadyatana·πÉ la·πÖa (imperfect = not today)
;; 6.1.3+: chordas≈ã... a·πÖhƒÅd...‚Üí augment a- prefixed to dhƒÅtuu
;;
;; The augment a- is NOT part of the a·πÖga (no gu·πáa on it).
;; It is simply prepended to the final combined list.
;; savar·πáa dƒ´rgha (6.1.101) handles a+h‚ÜíƒÅ if dhƒÅtu starts with a.
;; eco sandhi (6.1.78) handles a+i·ä
e, a+u‚Üío if needed.
;; ===========================================

(def derive-verb-laN
  (lambda (dhatu class-num ting-label)
    ((lambda (result)
       ;; Prepend augment a- to the derived form, then re-apply sandhi
       ;; (savar·πáa dƒ´rgha for a+vowel, eco for a+i/u)
       (apply-jjal-jhashi
         (apply-savar·πáa-dƒ´rgha
           (expand-eco-in-list
             (cons (quote a) result)))))
     (derive-verb-lakara dhatu class-num ting-label (quote ()) (quote laN))*JJ(
]`string helpers string substitution

(def derive-verb-string
  (lambda (dhatu class-num ting-label is-atmanepada)
    (symbol-list->string (derive-verb dhatu class-num ting-label is-atmanepada))))

;; === la·π≠ (present) named derivations ===

(def derive-pacati    (lambda () (derive-verb (quote (p a c)) 6 (quote tip) (quote ()))))
(def derive-bhavati   (lambda () (derive-verb (quote (b h U)) 1 (quote tip) (quote ()))))
(def derive-sunoti    (lambda () (derive-verb (quote (s u)) 5 (quote tip) (quote ()))))
(def derive-tanoti   (lambda () (derive-verb (quote (t a n)) 8 (quote tip) (quote ()))))
(def derive-corayati  (lambda () (derive-verb (quote (c u r)) 10 (quote tip) (quote ())))
(def derive-nayati    (lambda () (derive-verb (quote (n I)) 1 (quote tip) (quote ())))
(def derive-pazyati   (lambda () (derive-verb (quote (p a z)) 4 (quote tip) (quote ()))))
(def derive-kfSati    (lambda () (derive-verb (quote (k f S)) 6 (quote tip) (quote ()))))
(def derive-stavati   (lambda () (derive-verb (quote (s t u)) 1 (quote tip) (quote ()))))
(def derive-kroSayati (lambda () (derive-verb (quote (k r u S)) 10 (quote tip) (quote ()))))

activadhini  (lambda () (derive-verb (quote (b h U)) 1 (quote mip) (quote ())))
(def derive-sunomi    (lambda () (derive-verb (quote (s u)) 5 (quote mip) (quote ())))
(def derive-corayAmi  (lambda () (derive-verb (quote (c u r)) 10 (quote mip) (quote ())))

activanti  (lambda () (derive-verb (quote (b h U)) 1 (quote jhi) (quote ()))))
(def derive-sunvanti  (lambda () (derive-verb (quote (s u)) 5 (quote jhi) (quote ()))))
(def derive-corayanti (lambda () (derive-verb (quote (c u r)) 10 (quote jhi) (quote ())))

activantu   (lambda () (derive-verb-lot (quote (b h U)) 1 (quote jhi))))
(def derive-sunvantu  (lambda () (derive-verb-lot (quote (s u)) 5 (quote jhi))))
(def derive-corayantu (lambda () (derive-verb-lot (quote (c u r)) 10 (quote jhi))))
(def derive-pacantu    (lambda () (derive-verb-lot (quote (p a c)) 6 (quote jhi))))
(def derive-bhava      (lambda () (derive-verb-lot (quote (b h U)) 1 (quote sip))))
(def derive-paca      (lambda () (derive-verb-lot (quote (p a c)) 6 (quote sip))))
(def derive-suno      (lambda () (derive-verb-lot (quote (s u)) 5 (quote sip))))
(def derive-coraya    (lambda () (derive-verb-lot (quote (c u r)) 10 (quote sip))))
!derive-bhavAni   (lambda () (derive-verb-lot (quote (b h U)) 1 (quote mip))))
(def derive-pacAni     (lambda () (derive-verb-lot (quote (p a c)) 6 (quote mip))))
(def derive-corayAni   (lambda () (derive-verb-lot (quote (c u r)) 10 (quote mip))))

!=== la·πÖa (imperfect) named derivations ===

(def derive-abhavat    (lambda () (derive-verb-laN (quote (b h U)) 1 (quote tip))))
(def derive-apacat    (lambda () (derive-verb-laN (quote (p a c)) 6 (quote tip))))
(def derive-asunot     (lambda () (derive-verb-laN (quote (s u)) 5 (quote tip))))
(def derive-atanot     (lambda () (derive-verb-laN (quote (t a n)) 8 (quote tip))))
(def derive-acorayat   (lambda () (derive-verb-laN (quote (c u r)) 10 (quote tip)))
(def derive-anayat    (lambda () (derive-verb-laN (quote (n I)) 1 (quote tip))))
(def derive-apazyat   (lambda () (derive-verb-laN (quote (p a z)) 4 (quote tip))))
(def derive-akfSat     (lambda () (derive-verb-laN (quote (k f S)) 6 (quote tip))))

(def derive-abhavan    (lambda () (derive-verb-laN (quote (b h U)) 1 (quote jhi))))
(def derive-apacan    (lambda () (derive-verb-laN (quote (p a c)) 6 (quote jhi))))
(def derive-asunvan    (lambda () (derive-verb-laN (quote (s u)) 5 (quote jhi))))
(def derive-acorayan   (lambda () (derive-verb-laN (quote (c u r)) 10 (quote jhi)))

derive-abhavam    (lambda () (derive-verb-laN (quote (b h U)) 1 (quote mip))))
(def derive-apacam     (lambda () (derive-verb-laN (quote (p a c)) 6 (quote mip))))
(def derive-acorayam   (lambda () (derive-verb-laN (quote (c u r)) 10 (quote mip))))


;; ==========================================
;; liṅ (optative) derivation
;;
;; Architecture (Journal 0024, verified 15/15 = 100%):
;; - Optative REPLACES vikaraṇa entirely (sī marker)
;; - aṅga = dhātu (+ Ṇic for class 10), with guṇa, NO laṭ vikaraṇa
;; - Two ending types: e-type (a-final), yā-type (u-final)
;; - For Śnu/Śu (5,8): NO guṇa, yā-type endings
;; - Class 4: drop final 'a' from Śya→ya
;;
;; Pipeline: guṇa → combine aṅga + optative ending → eco → savarṇa → devoice
;; ==========================================

(def derive-verb-liN
  (lambda (dhatu class-num ting-label)
    ((lambda (vikarana-clean has-tit is-nic is-snu)
       ((lambda (anga)
          ((lambda (ting)
             ((lambda (combined)
                ;; Pipeline: eco → savarṇa → devoice
                (apply-jhal-jhashi
                  (apply-savarRa-dirgha
                    (expand-eco-in-list combined))))
              (append anga ting)))
           (get-lin-ting-para ting-label is-snu)))
        ;; Build aṅga based on class
        (cond
          (is-nic
           ;; Class 10: dhātu + Ṇic(i), guṇa ALL
           (apply-guRa-all-vowels (append dhatu vikarana-clean)))
          ((and has-tit (not is-snu))
           ;; Class 1: dhātu only (no Śap), guṇa last IK
           (apply-guRa-last-vowel dhatu))
          (is-snu
           ;; Class 5,8: dhātu + vikaraṇa (nu/u), NO guṇa (yā-type)
           (append dhatu vikarana-clean))
          ((equal? class-num 6)
           ;; Class 6: dhātu only, no guṇa, no vikaraṇa
           dhatu)
          ((equal? class-num 4)
           ;; Class 4: dhātu + Śya(ya), drop final 'a'
           (drop-last-a (append dhatu vikarana-clean)))
          (t
           ;; Class 2 and others: dhātu only
           dhatu))))
     (get-vikarana-clean class-num)
     (vikarana-has-tit? class-num)
     (is-nic-class? class-num)
     (is-snu-class? class-num))))

;; Helper: drop last 'a' from a sound list
(def drop-last-a
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds))
       (cond
         ((equal? (car sounds) (quote a)) (quote ()))
         (t sounds)))
      (t (cons (car sounds) (drop-last-a (cdr sounds)))))))

;; ==========================================
;; Ātmanepada derivation with staged sandhi
;;
;; Architecture (Journal 0025, verified 12/12 = 100%):
;; Sandhi must be staged by morphological depth:
;;   1. eco on aṅga+suffix (e/o + vowel → ay/av)
;;   2. savarṇa within aṅga (internal vowel merges)
;;   3. junction (a/ā + e → e; A + a → a at ādeśa boundary)
;;   4. combine aṅga + tiṅ
;;   5. coalescence (a+a → a at ādeśa boundary, NOT dīrgha)
;;   6. eco on final form
;;   7. savarṇa on final form
;;   8. devoice (8.4.55)
;; ==========================================

;; Junction: a/ā + e → e (guṇa vowel absorbs preceding a/ā)
(def apply-junction
  (lambda (anga-final ting)
    (cond
      ((and (not (atom anga-final))
            (member (last-sound anga-final) (quote (a A)))
            (not (atom ting))
            (equal? (car ting) (quote e)))
       (drop-last-sound anga-final))
      ;; A + a → a at ādeśa boundary
      ((and (not (atom anga-final))
            (equal? (last-sound anga-final) (quote A))
            (not (atom ting))
            (equal? (car ting) (quote a)))
       (replace-last-sound anga-final (quote a)))
      (t anga-final))))

;; Coalescence: a+a → a, A+a → a (at ādeśa boundary, NOT dīrgha!)
(def apply-coalescence
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((and (equal? (car sounds) (quote a))
            (not (atom (cdr sounds)))
            (equal? (car (cdr sounds)) (quote a)))
       (cons (quote a) (apply-coalescence (cdr (cdr sounds)))))
      ((and (equal? (car sounds) (quote A))
            (not (atom (cdr sounds)))
            (equal? (car (cdr sounds)) (quote a)))
       (cons (quote a) (apply-coalescence (cdr (cdr sounds)))))
      (t (cons (car sounds) (apply-coalescence (cdr sounds)))))))

;; Helper: get last sound from a list
(def last-sound
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds)) (car sounds))
      (t (last-sound (cdr sounds))))))

;; Helper: drop last sound from a list
(def drop-last-sound
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds)) (quote ()))
      (t (cons (car sounds) (drop-last-sound (cdr sounds)))))))

;; Helper: replace last sound in a list
(def replace-last-sound
  (lambda (sounds new-sound)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds)) (list new-sound))
      (t (cons (car sounds) (replace-last-sound (cdr sounds) new-sound))))))

;; Main ātmanepada derivation (laṭ)
(def derive-verb-atma
  (lambda (dhatu class-num ting-label)
    ((lambda (vikarana-clean has-tit is-nic is-snu)
       ((lambda (ting-clean)
          ;; ting-clean from pre-computed ṭere table (if ṭit)
          ((lambda (ting-final)
             ((lambda (vikarana-vrddhi)
                ((lambda (suffix)
                   ((lambda (anga-guna)
                      ((lambda (anga-final)
                         ;; Staged sandhi:
                         ;; 1. eco on anga+suffix
                         ;; 2. savarṇa within anga
                         ;; 3. junction (a/ā + e → e)
                         ((lambda (anga-junctioned)
                            ((lambda (combined)
                               ;; 5. coalescence (a+a → a)
                               ((lambda (coalesced)
                                  ;; 6-8. eco → savarṇa → devoice
                                  (apply-jhal-jhashi
                                    (apply-savarRa-dirgha
                                      (expand-eco-in-list coalesced))))
                                (apply-coalescence combined)))
                             (append anga-junctioned ting-final)))
                          ;; 3. junction
                          (apply-junction anga-final ting-final)))
                       ;; anga_final = anga_guna + suffix, with eco+savarṇa applied
                       (apply-savarRa-dirgha
                         (expand-eco-in-list
                           (append anga-guna suffix))))
                     ;; guṇa/yaṇ
                     (apply-guRa-to-anga dhatu vikarana-vrddhi has-tit is-nic is-snu ting-label)))
                  ;; suffix (class 10 only)
                  (cond
                    (is-nic
                     (apply-suffix-vrddhi (quote (a)) ting-label))
                    (t (quote ())))))
               ;; vṛddhi
               (apply-vrddhi vikarana-clean ting-label)))
            ;; ting from ṭere table
            (cond
              (has-tit
               (cdr (assoc ting-label lat-atma-ting-tit)))
              (t
               (remove-hal-antyam
                 (cdr (assoc ting-label ting-atma-raw)))))))
        (quote ())))
     (get-vikarana-clean class-num)
     (vikarana-has-tit? class-num)
     (is-nic-class? class-num)
     (is-snu-class? class-num))))

;; ==========================================
;; Named ātmanepada derivations (laṭ)
;; ==========================================

(def derive-bhavate    (lambda () (derive-verb-atma (quote (b h U)) 1 (quote ta))))
(def derive-bhavante   (lambda () (derive-verb-atma (quote (b h U)) 1 (quote ja))))
(def derive-bhavase    (lambda () (derive-verb-atma (quote (b h U)) 1 (quote thAs))))
(def derive-bhave      (lambda () (derive-verb-atma (quote (b h U)) 1 (quote iTw))))
(def derive-bhavAmahe (lambda () (derive-verb-atma (quote (b h U)) 1 (quote mahIM))))
(def derive-corayate   (lambda () (derive-verb-atma (quote (c u r)) 10 (quote ta))))
(def derive-corayanta  (lambda () (derive-verb-atma (quote (c u r)) 10 (quote ja))))
(def derive-coraye     (lambda () (derive-verb-atma (quote (c u r)) 10 (quote iTw))))
(def derive-sunote     (lambda () (derive-verb-atma (quote (s u)) 5 (quote ta))))
(def derive-sunvanta   (lambda () (derive-verb-atma (quote (s u)) 5 (quote ja))))
(def derive-tanote     (lambda () (derive-verb-atma (quote (t a n)) 8 (quote ta))))

;; ==========================================
;; Named liṅ (optative) derivations
;; ==========================================

(def derive-bhavet     (lambda () (derive-verb-liN (quote (b h U)) 1 (quote tip))))
(def derive-bhaveyus   (lambda () (derive-verb-liN (quote (b h U)) 1 (quote jhi))))
(def derive-bhaveyam   (lambda () (derive-verb-liN (quote (b h U)) 1 (quote mip))))
(def derive-pacet      (lambda () (derive-verb-liN (quote (p a c)) 6 (quote tip))))
(def derive-paceyus    (lambda () (derive-verb-liN (quote (p a c)) 6 (quote jhi))))
(def derive-paceyam    (lambda () (derive-verb-liN (quote (p a c)) 6 (quote mip))))
(def derive-corayet    (lambda () (derive-verb-liN (quote (c u r)) 10 (quote tip))))
(def derive-corayeyus  (lambda () (derive-verb-liN (quote (c u r)) 10 (quote jhi))))
(def derive-corayeyam  (lambda () (derive-verb-liN (quote (c u r)) 10 (quote mip))))
(def derive-pazyet     (lambda () (derive-verb-liN (quote (p a z)) 4 (quote tip))))
(def derive-nayet      (lambda () (derive-verb-liN (quote (n I)) 1 (quote tip))))
(def derive-kfSet      (lambda () (derive-verb-liN (quote (k f S)) 6 (quote tip))))
(def derive-sunuyAt    (lambda () (derive-verb-liN (quote (s u)) 5 (quote tip))))
(def derive-sunuyus    (lambda () (derive-verb-liN (quote (s u)) 5 (quote jhi))))
(def derive-sunuyAm    (lambda () (derive-verb-liN (quote (s u)) 5 (quote mip))))
