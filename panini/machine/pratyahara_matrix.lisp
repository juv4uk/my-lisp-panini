;; Lookup: (pa-member? sound pa-adi pa-marker)
(def pa-find-mask
  (lambda (pa-adi pa-marker)
    (cond
      ((atom *pa-bitmasks*) (quote ()))
      ((and (equal? (car (car *pa-bitmasks*)) pa-adi)
            (equal? (car (cdr (car *pa-bitmasks*))) pa-marker))
      (cdr (cdr (car *pa-bitmasks*))))
      (t (pa-find-mask pa-adi pa-marker (cdr *pa-bitmasks*))))))

(def sound-position
  (lambda (sound lst pos)
    (cond
      ((atom lst) (quote ()))
      ((equal? (car lst) sound) pos)
      (t (sound-position sound (cdr lst) (+ pos 1))))))

(def pa-member?
  (lambda (sound pa-adi pa-marker)
    (let ((mask (pa-find-mask pa-adi pa-marker))
          (idx (sound-position sound *sound-index* 0))))
      (if (and mask idx)
          (= (logand mask (ash 1 idx)) (ash 1 idx))
          (quote ())))))