;; Tiṅ System — verbal endings (3.4.78 + 3.4.79)
;;
;; Epistemic layer: ENGINEERING
;; Depends on: phonology.my
;; Upstream: SS-PRATYAHARA-001

(load "panini/machine/phonology.my")

;; ==========================================
;; 1.3.3 hal antyam + 1.3.9 tasya lopaḥ
;; ==========================================

(def hal? (lambda (sound) (in-hal? sound)))

(def apply-hal-antyam-lopa
  (lambda (sounds)
    (cond
      ((atom sounds) (quote ()))
      ((atom (cdr sounds)) (quote ()))
      (t (cons (car sounds) (apply-hal-antyam-lopa (cdr sounds)))))))

(def remove-it-markers
  (lambda (sounds markers)
    (cond
      ((atom sounds) (quote ()))
      ((member? (car sounds) markers)
       (remove-it-markers (cdr sounds) markers))
      (t (cons (car sounds) (remove-it-markers (cdr sounds) markers))))))

;; ==========================================
;; Tiṅ endings (3.4.78 + 3.4.79)
;; jhi encoded as (J i) — J is ñiṭ → ādeśa "nti" (8.4.62)
;; ==========================================

(def ting-parasmaipada
  (quote (
    (tip  . (t i p)) (tas  . (t a s)) (jhi  . (J i))
    (sip  . (s i p)) (thas . (t h a s)) (tha  . (t h a))
    (mip  . (m i p)) (vas  . (v a s)) (mas  . (m a s)))))

(def ting-atmanepada
  (quote (
    (ta   . (t a)) (AtAm . (A t A m)) (ja   . (j a))
    (thAs . (t h A s)) (AthAm . (A t h A m)) (Dvam . (D v a m))
    (iTw  . (i T w)) (vahi . (v a h i)) (mahIM . (m a h I M)))))

(def ting-lookup
  (lambda (label table)
    (cdr (assoc label table))))

;; get-ting-para: jhi → "nti" (ādeśa), others → hal-antyam-lopa
(def get-ting-para
  (lambda (label)
    (cond
      ((equal? label (quote jhi)) (quote (n t i)))
      (t (apply-hal-antyam-lopa (ting-lookup label ting-parasmaipada))))))

(def get-ting-atma
  (lambda (label)
    (apply-hal-antyam-lopa (ting-lookup label ting-atmanepada))))

;; ==========================================
;; Vikaraṇa table (expanded: classes 1, 4, 6, 10)
;; ==========================================
;; Class 1:  Śap  → a   (S=ṭit, p=hal)
;; Class 4:  Śya  → sya (S=ṭit)
;; Class 6:  Śa   → a   (S=ṭit)
;; Class 10: Ṇaya → aya (N=ṭit) [encoded as Ṇay to produce "aya" surface]

(def vikarana-table
  (quote (
    (1  . ((S a p)  (S p)))
    (4  . ((S y a)  (S)))
    (6  . ((S a)    (S)))
    (10 . ((N a y a)  (N))))))

(def get-vikarana
  (lambda (class-num)
    (car (cdr (assoc class-num vikarana-table)))))

(def get-vikarana-it-markers
  (lambda (class-num)
    (car (cdr (cdr (assoc class-num vikarana-table))))))

;; ṭit check: class 1 (Śap has 2 it-markers = ṭit), class 10 (Ṇaya has 1)
;; Guṇa applies to classes with ṭit: 1, 4, 10 (but not 6)
(def vikarana-has-tit?
  (lambda (class-num)
    (cond
      ((equal? class-num 1) t)
      ((equal? class-num 4) t)
      ((equal? class-num 10) t)
      ((equal? class-num 6) (quote ()))
      (t (quote ())))))

(def get-vikarana-clean
  (lambda (class-num)
    (remove-it-markers
      (get-vikarana class-num)
      (get-vikarana-it-markers class-num))))

;; ==========================================
;; 3.4.79: ṭere
;; ==========================================

(def apply-tere
  (lambda (ting-clean has-tit is-atmanepada)
    (cond
      ((and is-atmanepada has-tit (equal? ting-clean (quote (t a))))
       (quote (t e)))
      (t ting-clean))))
