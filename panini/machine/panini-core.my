;; Panini Machine Model v0.1
;; Core Definitions for the Symbolic Virtual Machine
;; All identifiers strictly use SLP1 encoding.

;; ==========================================
;; Kāraka (Semantic Roles / Edges)
;; ==========================================
;; These represent the typed edges in our semantic graph AST.
(def karaka-registry
  (list
    (cons 'apAdAna    (list (cons 'sutra "1.4.24") (cons 'semantic-role 'source)))
    (cons 'sampradAna (list (cons 'sutra "1.4.32") (cons 'semantic-role 'recipient)))
    (cons 'karaRa     (list (cons 'sutra "1.4.42") (cons 'semantic-role 'instrument)))
    (cons 'aDikaraRa  (list (cons 'sutra "1.4.45") (cons 'semantic-role 'location)))
    (cons 'karman     (list (cons 'sutra "1.4.49") (cons 'semantic-role 'patient)))
    (cons 'kartf      (list (cons 'sutra "1.4.54") (cons 'semantic-role 'agent)))))

;; Helper to fetch a karaka's property
(def get-karaka
  (lambda (k-id prop)
    (cdr (assoc prop (cdr (assoc k-id karaka-registry))))))

;; ==========================================
;; Dhātu (Action / Operator Nodes)
;; ==========================================
;; AUTHORITATIVE SOURCE: panini/registry/dhatu/*.yaml (20 verified entries).
;;
;; The authoritative registry is YAML-based (registry/dhatu/*.yaml).
;; When My Lisp gains YAML/file I/O, this should be replaced by:
;;   (load-dhatu-registry "/mnt/c/GitHub/my-lisp-panini/panini/registry/dhatu/")
;;
;; *test-dhatu-registry* is a SNAPSHOT for smoke-tests only.
;; It is NOT an authoritative source. Do NOT add entries here;
;; add them to registry/dhatu/*.yaml instead.
;; See: PANINI-MACHINE-DHATU-REGISTRY-SINGLE-SOURCE
(def *test-dhatu-registry*
  (list
    ;; SLP1         meaning (SLP1)   gana  pada            anit/seT
    (cons 'BU   (list (cons 'meaning "sattAyAm")    (cons 'class 1) (cons 'properties (list 'parasmaipadin 'seT))))
    (cons 'eD   (list (cons 'meaning "vfdDau")      (cons 'class 1) (cons 'properties (list 'Atmanepadin 'seT))))
    (cons 'dA   (list (cons 'meaning "dAne")        (cons 'class 3) (cons 'properties (list 'uBayapadin 'aniT))))
    (cons 'kf   (list (cons 'meaning "karaRe")      (cons 'class 8) (cons 'properties (list 'uBayapadin 'aniT))))
    (cons 'gam  (list (cons 'meaning "gatau")       (cons 'class 1) (cons 'properties (list 'parasmaipadin 'aniT))))
    (cons 'sTA  (list (cons 'meaning "gatinivfttau") (cons 'class 1) (cons 'properties (list 'parasmaipadin 'aniT))))
    ;; Additional verified entries from registry/dhatu/
    (cons 'pac  (list (cons 'meaning "pAke")        (cons 'class 1) (cons 'properties (list 'uBayapadin 'seT))))
    (cons 'vac  (list (cons 'meaning "paribhASaRe") (cons 'class 2) (cons 'properties (list 'parasmaipadin 'aniT))))
    (cons 'han  (list (cons 'meaning "hiMsAgatyoH") (cons 'class 2) (cons 'properties (list 'parasmaipadin 'aniT))))))

;; Alias for compatibility: dhatu-registry → *test-dhatu-registry*
;; Remove once file-based loading is implemented.
(def dhatu-registry *test-dhatu-registry*)

;; ==========================================
;; Graph Modeling (Action Instantiation)
;; ==========================================
;; An action instance represents a dhātu with its kāraka arguments.
;;
;; FIXED (PANINI-MACHINE-FIXUP-ACTION-GRAPH-ARITY):
;; Previous version had fixed arity (kartf, karman) — rejected by
;; dhatu-karaka-relation.md: kāraka set depends on the sentence,
;; not on dhātu alone (e.g. pac may or may not have aDikaraRa).
;;
;; karaka-pairs is an a-list of (kAraka-id . entity) pairs.
;; Any subset of the six kāraka roles is valid:
;;   kartf, karman, karaRa, sampradAna, apAdAna, aDikaraRa
;;
;; [MY-LISP HYPOTHESIS] — graph edge model, see hypothesis-ledger.md H1
(def make-action-graph
  (lambda (action-id dhatu karaka-pairs)
    (list (cons 'action-id action-id)
          (cons 'dhAtu dhatu)
          (cons 'kAraka-args karaka-pairs))))

;; Helper: get a kāraka entity from an action-graph
(def action-get-karaka
  (lambda (ag k-id)
    (cdr (assoc k-id (cdr (assoc 'kAraka-args ag))))))

;; Example 1: "devadatta goes to the village" — kartf + karman only
(def example-gam
  (make-action-graph 'action-gam 'gam
    (list (cons 'kartf 'devadatta)
          (cons 'karman 'grAma))))

;; Example 2: "devadatta cooks rice in the pot" — kartf + karman + aDikaraRa
;; (sTAlyAM pacati odanam — the canonical 3-kAraka pac example)
(def example-pac-full
  (make-action-graph 'action-pac 'pac
    (list (cons 'kartf 'devadatta)
          (cons 'karman 'odana)
          (cons 'aDikaraRa 'sTAlI))))
